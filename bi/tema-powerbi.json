{
  "name": "App do Colaborador — Lima",
  "dataColors": [
    "#0b4da2",
    "#d97706",
    "#b02a6e",
    "#1f8f3a",
    "#6b46c1",
    "#8a6a00",
    "#94a3b8",
    "#475569"
  ],
  "good": "#166534",
  "neutral": "#64748b",
  "bad": "#b91c1c",
  "maximum": "#063573",
  "center": "#94a3b8",
  "minimum": "#e7eefa",
  "null": "#cbd5e1",
  "background": "#ffffff",
  "secondaryBackground": "#f1f5f9",
  "foreground": "#0f172a",
  "tableAccent": "#0b4da2",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 30,
      "color": "#0f172a"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#0f172a"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#334155"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#475569"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#ffffff" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#e2e8f0" } },
            "radius": 8
          }
        ],
        "dropShadow": [{ "show": false }],
        "visualHeader": [{ "show": false }],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#0f172a" } },
            "background": { "solid": { "color": "#ffffff" } },
            "alignment": "left",
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "showAxisTitle": false,
            "labelColor": { "solid": { "color": "#64748b" } },
            "fontSize": 10,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "showAxisTitle": false,
            "labelColor": { "solid": { "color": "#64748b" } },
            "fontSize": 10,
            "gridlineShow": true,
            "gridlineColor": { "solid": { "color": "#f1f5f9" } },
            "gridlineThickness": 1
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopCenter",
            "showTitle": false,
            "labelColor": { "solid": { "color": "#475569" } },
            "fontSize": 10
          }
        ],
        "labels": [
          {
            "show": false,
            "color": { "solid": { "color": "#0f172a" } },
            "fontSize": 10
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#0f172a" } },
            "fontSize": 30,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": { "solid": { "color": "#64748b" } },
            "fontSize": 10
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#f8fafc" } }
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#e2e8f0" } },
            "radius": 8
          }
        ],
        "header": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#334155" } },
            "fontSize": 10
          }
        ],
        "items": [
          {
            "fontColor": { "solid": { "color": "#0f172a" } },
            "fontSize": 10
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": { "solid": { "color": "#f1f5f9" } },
            "rowPadding": 4,
            "outlineColor": { "solid": { "color": "#e2e8f0" } }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#334155" } },
            "backColor": { "solid": { "color": "#f8fafc" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "values": [
          {
            "fontColor": { "solid": { "color": "#0f172a" } },
            "backColor": { "solid": { "color": "#ffffff" } },
            "backColorSecondary": { "solid": { "color": "#fbfcfe" } },
            "fontSize": 10
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": { "solid": { "color": "#f1f5f9" } },
            "rowPadding": 4
          }
        ],
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#334155" } },
            "backColor": { "solid": { "color": "#f8fafc" } },
            "fontSize": 10
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#f8fafc" } },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": { "solid": { "color": "#f8fafc" } },
            "transparency": 0
          }
        ]
      }
    }
  }
}
