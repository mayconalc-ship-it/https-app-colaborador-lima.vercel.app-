// ==================================================================
// MEDIDAS DO BI DO APP DO COLABORADOR
// ==================================================================
// Como usar (Power BI Desktop, versão de 2024 em diante):
//
//   1. Crie antes a tabela _Medidas:
//      Página Inicial > Inserir dados > nomeie "_Medidas" > OK.
//   2. Barra lateral esquerda > ícone "Exibição de consulta DAX".
//   3. Cole ESTE ARQUIVO INTEIRO na consulta.
//   4. Acima de cada MEASURE aparece o link "Atualizar modelo: adicionar
//      nova medida". Clique em cada um -- ou use o botão do topo para
//      aplicar todas de uma vez, se a sua versão oferecer.
//   5. Depois de aplicadas, oculte a coluna "Coluna1" da _Medidas.
//
// Se a sua versão do Desktop não tiver a exibição de consulta DAX, o
// caminho alternativo é o Tabular Editor 2 (gratuito, aba Ferramentas
// Externas) -- ou colar uma a uma em Modelagem > Nova medida.
//
// As medidas se referenciam entre si. Se aplicar em ordem diferente da
// do arquivo, algumas acusam erro até a dependência existir; reaplique
// no fim e o erro some.
//
// Nomes de tabela assumidos: os das views do esquema bi, sem prefixo
// (fato_ag_contagem, dim_calendario...). Se você renomeou algo no Power
// Query, ajuste aqui antes de colar.

DEFINE

// ------------------------------------------------------------------
// EXECUTIVO
// ------------------------------------------------------------------

// Carimbo de atualização, para a capa. O valor nasce congelado no
// instante em que o modelo atualizou -- não é a hora de quem abre o
// arquivo, e a diferença é o ponto: um .pbix aberto na segunda pode
// estar com dado de sexta.
//
// SELECTEDVALUE e não MAX: a tabela tem uma linha só, e se um dia
// passar a ter mais, "o maior carimbo" seria uma resposta errada
// disfarçada de certa. Vazio avisa; número errado, não.
MEASURE '_Medidas'[Atualizado em] =
    SELECTEDVALUE ( dim_atualizacao[atualizado_rotulo] )

MEASURE '_Medidas'[Colaboradores] =
    DISTINCTCOUNT ( dim_colaborador[colaborador_id] )

MEASURE '_Medidas'[Colaboradores ativos] =
    DISTINCTCOUNT ( fato_atividade[colaborador_id] )

// --- Adesão: a mesma conta da tela ---------------------------------
//
// O cartão "Adesão desde o lançamento" de /admin/metricas divide quem JÁ
// ENTROU no app alguma vez pelo total de colaboradores da revenda. Duas
// coisas o BI fazia diferente, e por isso os números não batiam:
//
//   1) Numerador. O BI contava quem teve INTERAÇÃO em fato_atividade --
//      contagem de AG, feedback, quiz, curtida. Quem abre o app todo dia
//      e não lança nada ficava de fora, e o app conta essa pessoa.
//   2) Janela. O app olha a vida toda do app; o BI olhava o período do
//      filtro. Com o ano inteiro aberto a diferença era pequena, e num
//      recorte de semana ficava enorme.
//
// eventos_acesso com tipo 'login' é o equivalente de uso_sessoes, que é
// a tabela que a tela usa: RegistroDeUso.tsx grava a sessão e, na
// sequência, registrarEvento("login"). Um por sessão. A diferença é que
// eventos_acesso carrega revenda_id e a chave do colaborador, então
// respeita as segmentações de Revenda, Área e Colaborador -- uso_sessoes
// não tem revenda na origem e ficaria fora de qualquer recorte.
//
// REMOVEFILTERS(dim_calendario) é o "desde o lançamento". Se um dia a
// tela passar a recortar por período, tire daqui também.
MEASURE '_Medidas'[Colaboradores que já entraram] =
    CALCULATE (
        DISTINCTCOUNT ( fato_evento_acesso[colaborador_id] ),
        fato_evento_acesso[tipo] = "login",
        REMOVEFILTERS ( dim_calendario )
    )

MEASURE '_Medidas'[% Adesão] =
    DIVIDE ( [Colaboradores que já entraram], [Colaboradores] )

// A adesão do período continua existindo -- ela é que responde "quantos
// usaram o app NESTE mês", e é a base da comparação mês a mês. O que ela
// não pode é se chamar "% Adesão", porque esse nome já está na tela do
// app querendo dizer outra coisa.
MEASURE '_Medidas'[% Ativos no período] =
    DIVIDE ( [Colaboradores ativos], [Colaboradores] )

MEASURE '_Medidas'[Interações] =
    SUM ( fato_atividade[interacoes] )

MEASURE '_Medidas'[Módulos usados] =
    DISTINCTCOUNT ( fato_atividade[modulo] )

// Comparação mês a mês tem de usar a medida do PERÍODO: "% Adesão" hoje
// ignora o filtro de data, e a diferença daria zero sempre.
MEASURE '_Medidas'[% Ativos mês anterior] =
    CALCULATE ( [% Ativos no período], DATEADD ( dim_calendario[data], -1, MONTH ) )

MEASURE '_Medidas'[Δ Adesão] =
    VAR Atual = [% Ativos no período]
    VAR Anterior = [% Ativos mês anterior]
    RETURN IF ( NOT ISBLANK ( Anterior ), Atual - Anterior )

// Quem não abriu o app no período. Costuma ser o número mais acionável
// do relatório inteiro -- e é o que nenhum gráfico de volume mostra.
MEASURE '_Medidas'[Colaboradores sem atividade] =
    [Colaboradores] - [Colaboradores ativos]

// --- Média vs. última semana válida --------------------------------
// "Válida" = semana com pelo menos um registro. A semana corrente,
// ainda pela metade, é descartada de propósito: incluí-la faz o
// indicador despencar toda segunda-feira por motivo nenhum.

MEASURE '_Medidas'[Interações — média semanal] =
    VAR Semanas =
        ADDCOLUMNS (
            ALLSELECTED ( dim_calendario[inicio_semana] ),
            "@Qtd", CALCULATE ( [Interações] )
        )
    RETURN
        AVERAGEX ( FILTER ( Semanas, [@Qtd] > 0 ), [@Qtd] )

MEASURE '_Medidas'[Interações — última semana válida] =
    VAR InicioSemanaAtual = TODAY () - WEEKDAY ( TODAY (), 3 )
    VAR Semanas =
        FILTER (
            ADDCOLUMNS (
                FILTER (
                    ALLSELECTED ( dim_calendario[inicio_semana] ),
                    dim_calendario[inicio_semana] < InicioSemanaAtual
                ),
                "@Qtd", CALCULATE ( [Interações] )
            ),
            [@Qtd] > 0
        )
    VAR Ultima = MAXX ( Semanas, dim_calendario[inicio_semana] )
    RETURN
        MAXX ( FILTER ( Semanas, dim_calendario[inicio_semana] = Ultima ), [@Qtd] )

MEASURE '_Medidas'[Δ Última semana vs. média] =
    DIVIDE (
        [Interações — última semana válida] - [Interações — média semanal],
        [Interações — média semanal]
    )

// ------------------------------------------------------------------
// ATIVO DE GIRO
// ------------------------------------------------------------------

// LINHA LANÇADA, e não contagem. Uma pessoa que conta o pátio digita
// dezenas destas -- uma por tipo/formato. O nome antigo era "Contagens",
// e era ele que fazia a leitura errada parecer certa.
MEASURE '_Medidas'[Linhas lançadas] =
    COUNTROWS ( fato_ag_contagem )

MEASURE '_Medidas'[Contadores] =
    DISTINCTCOUNT ( fato_ag_contagem[colaborador_id] )

MEASURE '_Medidas'[Dias com contagem] =
    DISTINCTCOUNT ( fato_ag_contagem[data] )

// Só as contagens VIVAS: a recontagem SOBREPÕE a contagem antiga
// (migration 109), e o app soma só as vivas (vivas() em
// src/lib/ativo-giro.ts). Somar tudo contava o item recontado duas
// vezes. Esta medida alimenta Caixas de garrafeira, Paletes de
// garrafeira e Caixas no dia — o filtro vale para todas por aqui.
MEASURE '_Medidas'[Total em caixas] =
    CALCULATE ( SUM ( fato_ag_contagem[total_caixas] ), fato_ag_contagem[viva] = TRUE () )

MEASURE '_Medidas'[% Participação AG] =
    DIVIDE ( [Contadores], [Colaboradores] )

MEASURE '_Medidas'[% Lançado no dia] =
    DIVIDE (
        CALCULATE ( [Linhas lançadas], fato_ag_contagem[lancado_no_dia] = TRUE () ),
        [Linhas lançadas]
    )

MEASURE '_Medidas'[Atraso médio (dias)] =
    AVERAGE ( fato_ag_contagem[atraso_dias] )

// Sinalizador de dado quebrado: se acender, falta cadastrar fator de
// conversão de algum formato e o total em caixas está subestimado.
MEASURE '_Medidas'[Linhas sem fator] =
    CALCULATE ( [Linhas lançadas], fato_ag_contagem[fator_ausente] = TRUE () )

// O filtro parque_confiavel saiu destas quatro medidas.
//
// Ele nasceu de uma leitura errada do modelo: como ag_parque guarda um
// saldo só, sobrescrito a cada ajuste, a coluna parque_confiavel marca
// os dias em que o parque foi atualizado, e o filtro descartava todo o
// resto. Só que o parque é FIXO por desenho — é o cadastro do que a
// revenda tem, não uma medição diária —, e a conciliação é exatamente
// contagem contra esse cadastro. Exigir "parque atualizado no mesmo dia"
// zerava as duas medidas que aparecem na tabela de aderência: elas
// vinham em branco desde sempre, e ninguém tinha como saber por quê.
//
// A coluna continua existindo na view. Se um dia o parque passar a ter
// histórico (03-opcional-historico-parque-ag.sql), ela volta a ter uso.
MEASURE '_Medidas'[Divergência absoluta] =
    SUM ( fato_ag_conciliacao[diferenca_abs] )

MEASURE '_Medidas'[Itens conciliados] =
    COUNTROWS ( fato_ag_conciliacao )

MEASURE '_Medidas'[% Itens que bateram] =
    DIVIDE (
        CALCULATE (
            COUNTROWS ( fato_ag_conciliacao ),
            fato_ag_conciliacao[resultado] = "Bateu"
        ),
        [Itens conciliados]
    )

MEASURE '_Medidas'[Maior divergência] =
    MAX ( fato_ag_conciliacao[diferenca_abs] )

// --- Painel do app -------------------------------------------------
// Reproduz a aba "Painel" de /ativo-de-giro. O objetivo é que o número
// da tela e o número do BI sejam o mesmo número — se divergirem, alguém
// vai passar a auditar os dois no Excel.

MEASURE '_Medidas'[Caixas de garrafeira] =
    CALCULATE (
        [Total em caixas],
        fato_ag_contagem[tipo] = "GFE sem Garrafa"
    )

// paletesEquivalentes() divide o total JÁ SOMADO do formato pelo fator
// daquele formato. Por isso o SUMX por formato: somar a coluna
// paletes_equivalentes acumularia o arredondamento de cada linha, e a
// tela mostraria 12,4 onde o BI mostraria 12,6.
MEASURE '_Medidas'[Paletes de garrafeira] =
    SUMX (
        VALUES ( fato_ag_contagem[formato] ),
        DIVIDE (
            CALCULATE ( [Caixas de garrafeira] ),
            CALCULATE ( MAX ( fato_ag_contagem[fator_palete] ) )
        )
    )

// --- Fotografia do dia, e não soma de dias -------------------------
//
// AG é contagem de ESTOQUE. Cada dia é uma fotografia do mesmo parque,
// não um lote novo que entrou. Somar dois dias conta o mesmo palete duas
// vezes, e "total contado no mês" vira um número que só cresce, sem
// significar volume nenhum.
//
// Por isso todo visual de VOLUME desta página lê o último dia contado
// dentro do período selecionado. O ALLSELECTED é o que faz esse dia ser
// o mesmo para todas as linhas do visual: sem ele, cada colaborador
// apareceria no seu próprio último dia, e a soma da coluna seria de dias
// diferentes — pior que o acumulado, porque parece certa.
//
// Aderência e disciplina continuam somando dias, e devem mesmo: lá a
// pergunta é "com que frequência se conta", não "quanto tem".

MEASURE '_Medidas'[Último dia contado] =
    VAR Dia =
        CALCULATE ( MAX ( fato_ag_contagem[data] ), ALLSELECTED ( fato_ag_contagem ) )
    RETURN
        IF ( NOT ISBLANK ( Dia ), FORMAT ( Dia, "dd/MM/yyyy" ) )

MEASURE '_Medidas'[Caixas no dia] =
    VAR Dia =
        CALCULATE ( MAX ( fato_ag_contagem[data] ), ALLSELECTED ( fato_ag_contagem ) )
    RETURN
        CALCULATE ( [Total em caixas], fato_ag_contagem[data] = Dia )

// Paletes e caixas como foram DIGITADOS, sem conversão: a pergunta do
// painel de garrafeira é quantos paletes de GFE sem garrafa estão no
// pátio, e converter para caixas responde outra coisa.
MEASURE '_Medidas'[Paletes GFE] =
    VAR Dia =
        CALCULATE ( MAX ( fato_ag_contagem[data] ), ALLSELECTED ( fato_ag_contagem ) )
    RETURN
        CALCULATE (
            SUM ( fato_ag_contagem[palete] ),
            fato_ag_contagem[data] = Dia,
            fato_ag_contagem[tipo] = "GFE sem Garrafa",
            // Só as vivas — ver [Total em caixas].
            fato_ag_contagem[viva] = TRUE ()
        )

MEASURE '_Medidas'[Caixas GFE] =
    VAR Dia =
        CALCULATE ( MAX ( fato_ag_contagem[data] ), ALLSELECTED ( fato_ag_contagem ) )
    RETURN
        CALCULATE (
            SUM ( fato_ag_contagem[caixa] ),
            fato_ag_contagem[data] = Dia,
            fato_ag_contagem[tipo] = "GFE sem Garrafa",
            // Só as vivas — ver [Total em caixas].
            fato_ag_contagem[viva] = TRUE ()
        )

// --- Conciliação do dia, igual à do app ----------------------------
// conciliar() em src/lib/ativo-giro.ts soma todas as contagens do
// tipo+formato NAQUELE dia e compara com o parque. Sem o recorte de um
// dia só, "contado" viraria a soma de todas as contagens do período
// contra um parque que é saldo, e a diferença não significaria nada.

/*
    O DIA DA CONCILIAÇÃO (12/09/2026, pedido do dono: filtro de DIA no
    lugar do Período, podendo marcar mais de um).

    Numa linha que já é de um dia (a coluna Dia da tabela, cada dia do
    histórico e do gráfico), é aquele dia. Fora disso -- cartões, linha de
    total --, é o ÚLTIMO dia marcado: conciliação é fotografia de um dia, e
    somar o parque de três dias daria um número que não existe.
*/
MEASURE '_Medidas'[Dia da conciliação] =
    IF (
        HASONEVALUE ( fato_ag_conciliacao[data] ),
        VALUES ( fato_ag_conciliacao[data] ),
        CALCULATE ( MAX ( fato_ag_conciliacao[data] ), ALLSELECTED ( fato_ag_conciliacao ) )
    )

/*
    O CONFERENTE JÁ VEM NO DIA CONGELADO (12/09/2026).

    Cada conferente conta o pátio inteiro -- dupla contagem cega, ver a
    tela de conciliação do app: somar dois deu 131% do parque em 29/08.
    O dia congelado guarda a contagem de UM deles, e o filtro de
    Conferente é a coluna dele no próprio fato. Por isso as medidas desta
    parte são somas simples: não há conta de conferente a fazer aqui.
*/
MEASURE '_Medidas'[Contado] =
    VAR Dia = [Dia da conciliação]
    RETURN
        CALCULATE ( SUM ( fato_ag_conciliacao[contado] ), fato_ag_conciliacao[data] = Dia )

MEASURE '_Medidas'[Parque] =
    VAR Dia = [Dia da conciliação]
    RETURN
        CALCULATE ( SUM ( fato_ag_conciliacao[parque] ), fato_ag_conciliacao[data] = Dia )

MEASURE '_Medidas'[Diferença] =
    VAR C = [Contado]
    VAR T = [Em trânsito]
    VAR P = [Parque]
    RETURN
        IF (
            NOT ( ISBLANK ( C ) && ISBLANK ( T ) && ISBLANK ( P ) ),
            COALESCE ( C, 0 ) + COALESCE ( T, 0 ) - COALESCE ( P, 0 )
        )

/*
    AS TRÊS PARCELAS FORA DO PÁTIO — a parte da conta do app que o BI não
    tinha (10/09/2026).

    A diferença do app é contado + rota + carreta + comodato − parque. As
    três parcelas são ativo DA REVENDA que ninguém consegue contar porque
    não está no pátio: saiu com a entrega, está com o transportador ou
    emprestado ao cliente. Sem elas, todo dia com entrega na rua acusava
    falta — era a "diferença sempre alta" que o dono via no BI.

    Mesmo recorte de dia de [Contado] e [Parque]: a fotografia do último
    dia conciliado dentro do filtro.
*/
MEASURE '_Medidas'[Trânsito rota] =
    VAR Dia = [Dia da conciliação]
    RETURN
        CALCULATE ( SUM ( fato_ag_conciliacao[transito_rota] ), fato_ag_conciliacao[data] = Dia )

MEASURE '_Medidas'[Trânsito carreta] =
    VAR Dia = [Dia da conciliação]
    RETURN
        CALCULATE ( SUM ( fato_ag_conciliacao[transito_carreta] ), fato_ag_conciliacao[data] = Dia )

// O comodato é um saldo que vale até alguém mudar (igual ao parque), e a
// view já o repete em todo dia conciliado. Por isso o mesmo recorte de dia
// funciona aqui sem somar o mesmo comodato duas vezes.
MEASURE '_Medidas'[Comodato] =
    VAR Dia = [Dia da conciliação]
    RETURN
        CALCULATE ( SUM ( fato_ag_conciliacao[comodato] ), fato_ag_conciliacao[data] = Dia )

MEASURE '_Medidas'[Em trânsito] =
    VAR R = [Trânsito rota]
    VAR C = [Trânsito carreta]
    VAR M = [Comodato]
    RETURN
        IF (
            NOT ( ISBLANK ( R ) && ISBLANK ( C ) && ISBLANK ( M ) ),
            COALESCE ( R, 0 ) + COALESCE ( C, 0 ) + COALESCE ( M, 0 )
        )

// A diferença em MÓDULO sobre o parque — a mesma conta da tela. No total,
// soma antes de dividir (média de porcentagens daria o mesmo peso a uma
// linha de 100 caixas e a uma de 18 mil). Sem parque não há percentual:
// dividir por zero não dá "0% de erro", dá pergunta sem resposta.
MEASURE '_Medidas'[% Diferença] =
    VAR P = [Parque]
    RETURN
        IF ( P > 0, DIVIDE ( ABS ( [Diferença] ), P ) )

// O verde e o vermelho da tela, em texto. Aceitável até 5% do parque
// (LIMITE_DIFERENCA_PCT em src/lib/ativo-giro.ts) — não é meta de
// desempenho, é o ruído normal de um parque que se move o dia inteiro.
MEASURE '_Medidas'[Situação da conciliação] =
    VAR D = [Diferença]
    VAR P = [Parque]
    VAR Pct = [% Diferença]
    RETURN
        SWITCH (
            TRUE (),
            ISBLANK ( D ), BLANK (),
            ISBLANK ( P ) || P <= 0, "Sem parque",
            Pct <= 0.05, "✅ Dentro do aceitável",
            D > 0, "⚠️ Sobra acima de 5%",
            "❌ Falta acima de 5%"
        )

// O dia que a conciliação está mostrando. Todo número desta parte é a
// FOTOGRAFIA de um dia — e quem lê precisa saber de qual antes de levar
// a diferença para a reunião.
MEASURE '_Medidas'[Dia conciliado] =
    VAR Dia = [Dia da conciliação]
    RETURN
        IF ( NOT ISBLANK ( Dia ), FORMAT ( Dia, "dd/MM/yyyy" ) )

/*
    O HISTÓRICO DIA A DIA — a aba Histórico do app (conciliarPorDia).

    Numa linha de dia, cada medida é o total EXATO daquele dia. Na linha
    de total ela é a MÉDIA DIÁRIA do período, e não a soma: somar o parque
    de trinta dias daria trinta vezes o parque, um número que não existe.
    O "por dia" no nome é para isso ficar dito na coluna.
*/
// Cada dia pelas MESMAS medidas da fotografia (12/09/2026): dentro do
// AVERAGEX o dia é um só, e [Dia da conciliação] devolve aquele dia. É o
// que faz o histórico e o gráfico acompanharem o filtro de Conferente --
// somar as colunas da view daria sempre o contado de todo mundo.
MEASURE '_Medidas'[Contado por dia] =
    AVERAGEX ( VALUES ( fato_ag_conciliacao[data] ), [Contado] )

MEASURE '_Medidas'[Em trânsito por dia] =
    AVERAGEX ( VALUES ( fato_ag_conciliacao[data] ), [Em trânsito] )

MEASURE '_Medidas'[Parque por dia] =
    AVERAGEX ( VALUES ( fato_ag_conciliacao[data] ), [Parque] )

MEASURE '_Medidas'[Diferença por dia] =
    AVERAGEX ( VALUES ( fato_ag_conciliacao[data] ), [Diferença] )

MEASURE '_Medidas'[% Diferença por dia] =
    AVERAGEX ( VALUES ( fato_ag_conciliacao[data] ), [% Diferença] )

/*
    EM R$ (12/09/2026, pedido do dono: "ter valores em R$").

    O valor da caixa vem GRAVADO no dia congelado
    (ag_congelamento_itens.valor_caixa), então mudar o preço na
    configuração não muda o que já foi para a reunião. Item que não tinha
    valor cadastrado quando o dia foi congelado fica fora da soma em R$ --
    e [Itens sem valor] diz quantos, para o total não parecer completo sem
    estar.
*/
MEASURE '_Medidas'[Diferença (R$)] =
    VAR Dia = [Dia da conciliação]
    RETURN
        CALCULATE ( SUM ( fato_ag_conciliacao[diferenca_valor] ), fato_ag_conciliacao[data] = Dia )

MEASURE '_Medidas'[Contado (R$)] =
    VAR Dia = [Dia da conciliação]
    RETURN
        CALCULATE ( SUM ( fato_ag_conciliacao[contado_valor] ), fato_ag_conciliacao[data] = Dia )

MEASURE '_Medidas'[Em trânsito (R$)] =
    VAR Dia = [Dia da conciliação]
    RETURN
        CALCULATE ( SUM ( fato_ag_conciliacao[transito_valor] ), fato_ag_conciliacao[data] = Dia )

MEASURE '_Medidas'[Parque (R$)] =
    VAR Dia = [Dia da conciliação]
    RETURN
        CALCULATE ( SUM ( fato_ag_conciliacao[parque_valor] ), fato_ag_conciliacao[data] = Dia )

MEASURE '_Medidas'[Diferença por dia (R$)] =
    AVERAGEX ( VALUES ( fato_ag_conciliacao[data] ), [Diferença (R$)] )

MEASURE '_Medidas'[Itens sem valor] =
    VAR Dia = [Dia da conciliação]
    RETURN
        CALCULATE (
            COUNTROWS ( fato_ag_conciliacao ),
            fato_ag_conciliacao[data] = Dia,
            ISBLANK ( fato_ag_conciliacao[valor_caixa] )
        ) + 0

/*
    A GARRAFEIRA SEM GARRAFA DO DIA CONCILIADO (12/09/2026).

    A tabela saiu da página do Ativo de Giro e foi para a da Conciliação,
    a pedido do dono. Lá o dia é o do filtro de Dia (o dia congelado), e
    não o "último dia contado" -- estas duas medidas leem esse dia.
    Paletes e caixas como foram DIGITADOS, só as contagens vivas.
*/
MEASURE '_Medidas'[Paletes GFE do dia conciliado] =
    VAR Dia = [Dia da conciliação]
    RETURN
        CALCULATE (
            SUM ( fato_ag_contagem[palete] ),
            fato_ag_contagem[data] = Dia,
            fato_ag_contagem[tipo] = "GFE sem Garrafa",
            fato_ag_contagem[viva] = TRUE ()
        )

MEASURE '_Medidas'[Caixas GFE do dia conciliado] =
    VAR Dia = [Dia da conciliação]
    RETURN
        CALCULATE (
            SUM ( fato_ag_contagem[caixa] ),
            fato_ag_contagem[data] = Dia,
            fato_ag_contagem[tipo] = "GFE sem Garrafa",
            fato_ag_contagem[viva] = TRUE ()
        )

// --- Aderência ao processo -----------------------------------------
// "Ocorrências de contagem" é quantas VEZES se contou, não quanto se
// contou. É o que responde se a revenda está mantendo a rotina — volume
// alto num dia só não é aderência.
//
// ERA COUNTROWS(fato_ag_contagem), o que contradizia o próprio nome e o
// comentário acima: contava LINHA LANÇADA. Em 22/08/2026 o Matheus
// contou o pátio uma vez e digitou 21 linhas — o gráfico diário subia
// para 21 e dava a impressão de vinte e uma contagens naquele dia.
//
// fato_ag_dia_colaborador tem o grão certo: uma linha por pessoa por
// dia, ou seja, uma linha por VEZ que alguém contou. Naquele dia, 1.
// Para o volume de linhas, use [Linhas lançadas].
MEASURE '_Medidas'[Ocorrências de contagem] =
    COUNTROWS ( fato_ag_dia_colaborador )

MEASURE '_Medidas'[Dias úteis no período] =
    CALCULATE (
        COUNTROWS ( dim_calendario ),
        dim_calendario[fim_de_semana] = FALSE (),
        dim_calendario[ja_aconteceu] = TRUE ()
    )

MEASURE '_Medidas'[% Dias com contagem] =
    DIVIDE ( [Dias com contagem], [Dias úteis no período] )

// --- A meta da cia: 3 contagens por semana --------------------------
//
// "Contagem" aqui é DIA CONTADO, não linha lançada. Uma pessoa que
// digita 40 linhas numa terça e some o resto da semana lançou 40
// ocorrências e cumpriu UM terço da meta -- é isso que a régua da cia
// quer dizer com "3 por semana". A leitura por volume continua
// disponível em [Ocorrências de contagem], que mede outra coisa.
//
// A meta é constante e mora numa medida só. Quando a cia mudar de 3
// para 4, muda-se aqui e os quatro indicadores abaixo acompanham -- e o
// número não fica escrito à mão em cinco títulos de visual.
MEASURE '_Medidas'[Meta semanal de contagens] =
    3

// Semanas do CALENDÁRIO já decorridas dentro do que estiver filtrado.
// ja_aconteceu pelo mesmo motivo de [Dias úteis no período]: com o ano
// inteiro aberto, contar as 52 semanas jogaria o denominador para o
// futuro e todo mundo apareceria devendo meta que ainda nem venceu.
MEASURE '_Medidas'[Semanas no período] =
    CALCULATE (
        DISTINCTCOUNT ( dim_calendario[ano_semana] ),
        dim_calendario[ja_aconteceu] = TRUE ()
    )

MEASURE '_Medidas'[Meta de contagens] =
    [Meta semanal de contagens] * [Semanas no período]

MEASURE '_Medidas'[% da meta de contagens] =
    DIVIDE ( [Dias com contagem], [Meta de contagens] )

// O par do percentual acumulado, e o mais honesto dos dois: 12 dias
// contados em 4 semanas dá 100% da meta mesmo que 8 deles tenham caído
// na mesma semana. Esta medida conta SEMANA A SEMANA quantas fecharam
// com 3 ou mais.
MEASURE '_Medidas'[Semanas na meta] =
    COUNTROWS (
        FILTER (
            CALCULATETABLE (
                VALUES ( dim_calendario[ano_semana] ),
                dim_calendario[ja_aconteceu] = TRUE ()
            ),
            [Dias com contagem] >= [Meta semanal de contagens]
        )
    )

MEASURE '_Medidas'[% Semanas na meta] =
    DIVIDE ( [Semanas na meta], [Semanas no período] )

// O ritmo dia a dia. Devolve ZERO, e não vazio, no dia em que ninguém
// contou -- e a diferença é o gráfico inteiro.
//
// [Ocorrências de contagem] vem vazia no dia sem lançamento, e categoria
// vazia o Power BI simplesmente não desenha: a série pulava de 05 para
// 09 e o buraco de três dias -- que é exatamente o que a meta existe
// para vigiar -- sumia da tela. Com zero, a linha desce até o eixo e o
// dia parado fica visível.
//
// ja_aconteceu impede que o resto do mês apareça como uma fileira de
// zeros: dia que ainda não chegou não é dia sem contagem.
//
// CUIDADO com SELECTEDVALUE aqui -- foi assim que esta medida nasceu, e
// o gráfico saiu COMPLETAMENTE VAZIO. O eixo é dia_rotulo ("05"), e sem
// um mês escolhido esse "05" é o dia 5 de TODOS os meses do calendário:
// alguns já aconteceram, outros não. SELECTEDVALUE de vários valores
// devolve vazio, o IF nunca era verdadeiro e nenhuma categoria era
// desenhada -- sem erro, sem visual vazio com aviso, só um gráfico em
// branco.
//
// Contar os dias já decorridos por trás daquele rótulo resolve nos dois
// casos: com um mês filtrado é exatamente um dia, e sem filtro é
// qualquer dia 5 que já tenha passado. O gráfico deixa de depender de o
// usuário ter lembrado de escolher o mês.
MEASURE '_Medidas'[Contagens no dia] =
    VAR DiasDecorridos =
        CALCULATE (
            COUNTROWS ( dim_calendario ),
            dim_calendario[ja_aconteceu] = TRUE ()
        )
    RETURN
        IF ( DiasDecorridos > 0, COALESCE ( [Ocorrências de contagem], 0 ) )

MEASURE '_Medidas'[Recontagens pendentes] =
    CALCULATE (
        COUNTROWS ( fato_ag_recontagem ),
        fato_ag_recontagem[situacao] = "Pendente"
    )

MEASURE '_Medidas'[Horas médias p/ atender] =
    AVERAGE ( fato_ag_recontagem[horas_para_atender] )

// ------------------------------------------------------------------
// FEEDBACK DE ROTA
// ------------------------------------------------------------------

MEASURE '_Medidas'[Feedbacks] =
    COUNTROWS ( fato_feedback_rota )

MEASURE '_Medidas'[Nota média] =
    AVERAGE ( fato_feedback_rota[nota] )

MEASURE '_Medidas'[% Satisfação] =
    AVERAGE ( fato_feedback_rota[nota_percentual] )

MEASURE '_Medidas'[% Notas ruins] =
    DIVIDE (
        CALCULATE ( [Feedbacks], fato_feedback_rota[nota_ruim] = TRUE () ),
        [Feedbacks]
    )

MEASURE '_Medidas'[Motoristas que responderam] =
    DISTINCTCOUNT ( fato_feedback_rota[colaborador_id] )

MEASURE '_Medidas'[Rotas avaliadas] =
    DISTINCTCOUNT ( fato_feedback_rota[rota] )

MEASURE '_Medidas'[% Com comentário] =
    DIVIDE (
        CALCULATE ( [Feedbacks], fato_feedback_rota[tem_comentario] = TRUE () ),
        [Feedbacks]
    )

// A view de ocorrências é explodida (um feedback com 3 ocorrências vira
// 3 linhas). Contar linhas aqui triplicaria o volume.
MEASURE '_Medidas'[Feedbacks com ocorrência] =
    DISTINCTCOUNT ( fato_feedback_ocorrencia[feedback_id] )

MEASURE '_Medidas'[Ocorrências relatadas] =
    COUNTROWS ( fato_feedback_ocorrencia )

MEASURE '_Medidas'[% Rotas com ocorrência] =
    DIVIDE ( [Feedbacks com ocorrência], [Feedbacks] )

// --- Cidade, e não rota --------------------------------------------
//
// "Rota mais crítica" saiu do painel em 23/08/2026, e o motivo não é
// estatístico: é que o indicador não decidia nada. O número do mapa é
// gerado pela roteirização do dia -- a rota 14768 de ontem não é a rota
// 14768 do mês que vem --, então apontar um mapa como "o pior" não diz
// onde agir, nem no dia seguinte.
//
// A CIDADE se repete. bi.fato_feedback_cidade cruza o mapa que o
// motorista digitou com o relatório de rotas importado em /admin/rotas
// e devolve por onde aquele mapa passou. "As notas caem toda vez que o
// mapa passa por X" é uma frase sobre a qual dá para tomar decisão.
//
// O corte de 3 feedbacks continua, pelo mesmo motivo de antes: sem ele
// uma cidade com um único feedback ruim vira "a pior da revenda" na
// primeira reunião e o painel perde credibilidade de uma vez só.
MEASURE '_Medidas'[Feedbacks por cidade] =
    DISTINCTCOUNT ( fato_feedback_cidade[feedback_id] )

MEASURE '_Medidas'[Nota média por cidade] =
    AVERAGE ( fato_feedback_cidade[nota] )

// --- Média ajustada: por que a simples não serve para ranquear -------
//
// Medido em 23/08/2026, com 68 feedbacks em 11 cidades:
//
//   CORIBE      6 feedbacks   média 1,33   3 notas ruins
//   JABORANDI   3 feedbacks   média 1,33   1 nota ruim
//
// Empate na média simples. E empate em TOPN(1, ..., ASC) não devolve
// uma linha: devolve as duas, e o MAXX que vem depois fica com o maior
// TEXTO -- "JABORANDI" ganha de "CORIBE" por ordem alfabética. O painel
// apontava uma cidade por causa da letra J.
//
// O problema é mais fundo que o desempate. Média de 3 observações e
// média de 6 não têm o mesmo peso, e a de 3 varia muito mais: uma nota
// ruim a mais em Jaborandi derruba a média em 0,33, e em Coribe em
// 0,17. Ranquear as duas na mesma régua premia a amostra pequena.
//
// A correção é encolher a média de cada cidade em direção à média
// geral, na proporção de quantas observações ela tem -- é a média
// bayesiana que serviço de avaliação usa para não deixar um produto com
// uma única nota 5 encabeçar a lista:
//
//   ajustada = (soma das notas + m × média geral) ÷ (n + m)
//
// m = 5 é o peso do "benefício da dúvida": uma cidade com 5 feedbacks
// tem a nota puxada metade para a geral, uma com 20 quase não se move.
// Com os números acima, Coribe sai em 1,54 e Jaborandi em 1,63 -- a
// mesma média simples, e a ordem certa, porque Coribe sustentou aquela
// média o dobro de vezes.
//
// A média SIMPLES continua sendo a do gráfico. Ela é a que o time
// reconhece e a que se confere na mão; a ajustada serve para ordenar,
// não para comunicar.
MEASURE '_Medidas'[Nota média ajustada da cidade] =
    VAR Peso = 5
    VAR MediaGeral =
        CALCULATE (
            AVERAGE ( fato_feedback_cidade[nota] ),
            ALLSELECTED ( fato_feedback_cidade )
        )
    VAR Observacoes = CALCULATE ( COUNTROWS ( fato_feedback_cidade ) )
    VAR Soma = CALCULATE ( SUM ( fato_feedback_cidade[nota] ) )
    RETURN
        DIVIDE ( Soma + Peso * MediaGeral, Observacoes + Peso )

// Feedback cujo mapa não foi encontrado no relatório de rotas cai em
// 'Rota não localizada' e NÃO pode concorrer a pior cidade -- seria uma
// falha de importação virando diagnóstico de operação.
//
// O corte de 3 continua, e continua fazendo falta: a média ajustada
// ordena bem, mas não impede que uma cidade com um único feedback
// apareça no cartão. Em 23/08/2026 era o caso de SAO FELIX -- 1
// feedback, nota 0.
//
// O segundo critério do TOPN (mais feedbacks primeiro) é a rede de
// segurança: se duas cidades empatarem até na ajustada, ganha a que tem
// mais observações. Nunca mais por ordem alfabética.
MEASURE '_Medidas'[Cidade mais crítica] =
    VAR Cidades =
        CALCULATETABLE (
            ADDCOLUMNS (
                VALUES ( fato_feedback_cidade[cidade] ),
                "@Ajustada", [Nota média ajustada da cidade],
                "@Qtd", CALCULATE ( DISTINCTCOUNT ( fato_feedback_cidade[feedback_id] ) )
            ),
            fato_feedback_cidade[rota_localizada] = TRUE ()
        )
    VAR Elegiveis = FILTER ( Cidades, [@Qtd] >= 3 )
    VAR Pior = TOPN ( 1, Elegiveis, [@Ajustada], ASC, [@Qtd], DESC )
    RETURN
        MAXX ( Pior, fato_feedback_cidade[cidade] )

// Quanto do painel de cidade é confiável. Se cair, é sinal de que a
// roteirização parou de ser importada -- e não de que a operação piorou.
MEASURE '_Medidas'[% Rotas localizadas] =
    DIVIDE (
        CALCULATE (
            [Feedbacks por cidade],
            fato_feedback_cidade[rota_localizada] = TRUE ()
        ),
        [Feedbacks por cidade]
    )

// ------------------------------------------------------------------
// CINCO PORQUÊS
// ------------------------------------------------------------------

MEASURE '_Medidas'[Análises] =
    COUNTROWS ( fato_cinco_porques )

MEASURE '_Medidas'[Análises concluídas] =
    CALCULATE ( [Análises], fato_cinco_porques[concluida] = TRUE () )

MEASURE '_Medidas'[% Conclusão] =
    DIVIDE ( [Análises concluídas], [Análises] )

// SÓ AS CONCLUÍDAS NO NUMERADOR (12/09/2026). O numerador contava toda
// análise com 5 porquês, inclusive as que o motorista respondeu até o fim
// e não enviou -- e o denominador eram só as concluídas. Deu 140% no
// painel do dono: 7 com cinco porquês sobre 5 concluídas. Agora é a
// fração das concluídas, e o teto é 100%.
MEASURE '_Medidas'[% Chegou ao 5º porquê] =
    DIVIDE (
        CALCULATE (
            [Análises],
            fato_cinco_porques[chegou_ao_quinto] = TRUE (),
            fato_cinco_porques[concluida] = TRUE ()
        ),
        [Análises concluídas]
    )

// Análises que o motorista abriu e não enviou. É o que separa as
// concluídas do total em [% Conclusão] -- e o que o dono não via no app,
// que só lista as concluídas.
MEASURE '_Medidas'[Análises em andamento] =
    CALCULATE ( [Análises], fato_cinco_porques[concluida] = FALSE () )

/*
    A CADEIA DE CADA ANÁLISE, nível a nível (12/09/2026, pedido do dono:
    "ver de forma ilustrativa como foi feito o 5 porquês pelo motorista").

    Uma medida por nível, para a tabela pôr os cinco lado a lado na linha
    da análise. A resposta é a opção que o motorista marcou; quando ele
    escreveu por conta própria, o texto livre vem junto. Nível que ele
    não respondeu fica vazio -- é onde a análise parou.
*/
MEASURE '_Medidas'[1º porquê] =
    VAR R = CALCULATE ( MAX ( fato_cinco_porques_resposta[resposta] ), fato_cinco_porques_resposta[nivel] = 1 )
    VAR L = CALCULATE ( MAX ( fato_cinco_porques_resposta[texto_livre] ), fato_cinco_porques_resposta[nivel] = 1 )
    RETURN IF ( ISBLANK ( L ) || L = "", R, IF ( ISBLANK ( R ) || R = "", L, R & " — " & L ) )

MEASURE '_Medidas'[2º porquê] =
    VAR R = CALCULATE ( MAX ( fato_cinco_porques_resposta[resposta] ), fato_cinco_porques_resposta[nivel] = 2 )
    VAR L = CALCULATE ( MAX ( fato_cinco_porques_resposta[texto_livre] ), fato_cinco_porques_resposta[nivel] = 2 )
    RETURN IF ( ISBLANK ( L ) || L = "", R, IF ( ISBLANK ( R ) || R = "", L, R & " — " & L ) )

MEASURE '_Medidas'[3º porquê] =
    VAR R = CALCULATE ( MAX ( fato_cinco_porques_resposta[resposta] ), fato_cinco_porques_resposta[nivel] = 3 )
    VAR L = CALCULATE ( MAX ( fato_cinco_porques_resposta[texto_livre] ), fato_cinco_porques_resposta[nivel] = 3 )
    RETURN IF ( ISBLANK ( L ) || L = "", R, IF ( ISBLANK ( R ) || R = "", L, R & " — " & L ) )

MEASURE '_Medidas'[4º porquê] =
    VAR R = CALCULATE ( MAX ( fato_cinco_porques_resposta[resposta] ), fato_cinco_porques_resposta[nivel] = 4 )
    VAR L = CALCULATE ( MAX ( fato_cinco_porques_resposta[texto_livre] ), fato_cinco_porques_resposta[nivel] = 4 )
    RETURN IF ( ISBLANK ( L ) || L = "", R, IF ( ISBLANK ( R ) || R = "", L, R & " — " & L ) )

MEASURE '_Medidas'[5º porquê] =
    VAR R = CALCULATE ( MAX ( fato_cinco_porques_resposta[resposta] ), fato_cinco_porques_resposta[nivel] = 5 )
    VAR L = CALCULATE ( MAX ( fato_cinco_porques_resposta[texto_livre] ), fato_cinco_porques_resposta[nivel] = 5 )
    RETURN IF ( ISBLANK ( L ) || L = "", R, IF ( ISBLANK ( R ) || R = "", L, R & " — " & L ) )

MEASURE '_Medidas'[Profundidade média] =
    AVERAGE ( fato_cinco_porques[profundidade] )

// O par que decide se o módulo sobrevive: análise concluída que ninguém
// responde ensina o time a não preencher a próxima.
MEASURE '_Medidas'[Aguardando tratativa] =
    CALCULATE (
        [Análises],
        fato_cinco_porques[concluida] = TRUE (),
        fato_cinco_porques[tratada] = FALSE ()
    )

// Média COMBINADA de duas origens: o 5 Porquês (que só existe para nota
// "Ruim") e a tratativa direta do feedback "Regular" -- as duas fecham o
// mesmo ciclo (liderança responde a um relato do motorista), só que uma
// tem análise de causa raiz por trás e a outra não. Por isso não dá para
// usar AVERAGE numa coluna só: é soma das duas somas dividida pela soma
// das duas contagens, o que pondera por CASO respondido, não por módulo
// -- um mês com 40 tratativas de Regular e 5 análises de 5 Porquês pesa
// as 40 mais, e é assim que a liderança de fato vive o volume.
//
// fato_feedback_rota[reg_horas_ate_resposta] já vem NULL da view (ver
// bi.fato_feedback_rota em 01-camada-semantica.sql) quando
// reg_conta_tmr é falso -- é o caso do feedback "Regular" que já
// existia antes da tratativa virar obrigatória (migration 056) e foi
// reaberto em massa pra fila: contar o tempo desde o criado_em original
// inflaria a métrica por um atraso que é do lançamento da
// funcionalidade, não da liderança. Por isso o filtro aqui é só
// ISBLANK, sem precisar repetir a condição de reg_conta_tmr.
MEASURE '_Medidas'[Horas médias até resposta] =
    VAR SomaCincoPorques =
        CALCULATE ( SUM ( fato_cinco_porques[horas_ate_resposta] ) )
    VAR QtdCincoPorques =
        CALCULATE (
            COUNTROWS ( fato_cinco_porques ),
            NOT ISBLANK ( fato_cinco_porques[horas_ate_resposta] )
        )
    VAR SomaFeedbackRegular =
        CALCULATE ( SUM ( fato_feedback_rota[reg_horas_ate_resposta] ) )
    VAR QtdFeedbackRegular =
        CALCULATE (
            COUNTROWS ( fato_feedback_rota ),
            NOT ISBLANK ( fato_feedback_rota[reg_horas_ate_resposta] )
        )
    RETURN
        DIVIDE (
            SomaCincoPorques + SomaFeedbackRegular,
            QtdCincoPorques + QtdFeedbackRegular
        )

// TMR -- tempo médio de resposta, na unidade em que a liderança pensa.
//
// O cartão mostrava "Horas até resposta" e um número cru: 96,4. Ninguém
// lê 96,4 h como "quatro dias" sem parar para dividir, e é justamente
// acima de 24 h que o número deixa de ser um detalhe operacional e vira
// o problema. Abaixo de 24 h a hora é a unidade útil ("respondemos em
// 6 h"); acima, o dia é.
//
// Devolve TEXTO de propósito -- a unidade muda com o valor, e sufixo de
// format string não faz isso. Por isso o nome está em MEDIDAS_TEXTO no
// gerador: sem essa entrada, sairia com format string numérico em cima
// de um texto. Para ordenar ou comparar, use [Horas médias até
// resposta], que continua sendo o número.
MEASURE '_Medidas'[TMR] =
    VAR Horas = [Horas médias até resposta]
    RETURN
        IF (
            ISBLANK ( Horas ),
            BLANK (),
            IF (
                Horas < 24,
                FORMAT ( Horas, "0.0" ) & " h",
                FORMAT ( DIVIDE ( Horas, 24 ), "0.0" ) & " d"
            )
        )

MEASURE '_Medidas'[% Aceite do motorista] =
    DIVIDE (
        CALCULATE ( [Análises], fato_cinco_porques[motorista_aceitou] = TRUE () ),
        CALCULATE ( [Análises], fato_cinco_porques[respondida_lideranca] = TRUE () )
    )

MEASURE '_Medidas'[Causa raiz mais frequente] =
    VAR Causas =
        ADDCOLUMNS (
            VALUES ( fato_cinco_porques[categoria] ),
            "@Qtd", CALCULATE ( COUNTROWS ( fato_cinco_porques ) )
        )
    RETURN
        MAXX ( TOPN ( 1, Causas, [@Qtd], DESC ), fato_cinco_porques[categoria] )

// ------------------------------------------------------------------
// PLANO DE COMUNICAÇÃO
// ------------------------------------------------------------------

MEASURE '_Medidas'[Comunicados publicados] =
    COUNTROWS ( fato_comunicado )

MEASURE '_Medidas'[Curtidas] =
    SUM ( fato_comunicado[curtidas] )

MEASURE '_Medidas'[Curtidas por comunicado] =
    DIVIDE ( [Curtidas], [Comunicados publicados] )

MEASURE '_Medidas'[Taxa média de curtida] =
    AVERAGE ( fato_comunicado[taxa_curtida] )

MEASURE '_Medidas'[Colaboradores que interagiram] =
    DISTINCTCOUNT ( fato_comunicado_curtida[colaborador_id] )

MEASURE '_Medidas'[% Participação na comunicação] =
    DIVIDE ( [Colaboradores que interagiram], [Colaboradores] )

// PISO, não total: vem de notificacao_estado, que por desenho só ganha
// linha de quem interagiu com o sino. O app não registra abertura de
// comunicado. Mantenha o "(piso)" no rótulo do visual.
MEASURE '_Medidas'[Cliques no aviso (piso)] =
    SUM ( fato_comunicado[avisos_clicados] )

MEASURE '_Medidas'[Dias até curtir (mediana)] =
    MEDIANX ( fato_comunicado_curtida, fato_comunicado_curtida[dias_ate_curtir] )

// --- Cronograma (a visão de calendário do app) ----------------------
//
// A pergunta do calendário não é quanto se publicou -- é QUE DIAS
// FICARAM VAZIOS. Uma lista ordenada por data não responde isso: o
// buraco de duas semanas some entre duas linhas consecutivas. Numa
// grade semana x dia da semana, ele é o retângulo em branco.

MEASURE '_Medidas'[Itens do cronograma] =
    COUNTROWS ( fato_comunicado_agenda )

MEASURE '_Medidas'[Marcas na fila] =
    CALCULATE (
        [Itens do cronograma],
        fato_comunicado_agenda[na_fila] = TRUE ()
    )

// O conteúdo da célula do calendário. Texto, e não contagem: numa grade
// de 42 células, "2" não diz o que vai sair no dia -- e é exatamente
// isso que o RH está olhando quando monta o mês.
//
// UNICHAR(10) é a quebra de linha. Ela só aparece com quebra automática
// de texto ligada na matriz -- o gerador liga via quebraTexto.
MEASURE '_Medidas'[Agenda do dia] =
    CONCATENATEX (
        fato_comunicado_agenda,
        fato_comunicado_agenda[rotulo],
        UNICHAR ( 10 ),
        fato_comunicado_agenda[hora], ASC
    )

// A CÉLULA DO CALENDÁRIO -- o número do dia, e embaixo o que sai nele.
//
// É esta medida que faz a matriz virar calendário em vez de tabela
// cruzada. A primeira versão punha só os itens na célula: dia vazio
// ficava em branco, sem número, e quem olhava não sabia se aquele
// retângulo era o dia 12 ou o dia 19 -- a grade tinha sete colunas de
// dia da semana e nenhuma data. Era o "mês em grade" que não parecia
// mês nenhum.
//
// O número do dia vem SEMPRE, mesmo sem publicação. É ele que desenha a
// grade completa: a matriz omite a interseção cujo valor é vazio, então
// sem o número os dias sem nada sumiriam e as colunas encolheriam umas
// sobre as outras.
//
// SELECTEDVALUE devolve o dia só quando a célula é UM dia -- que é o
// caso de toda interseção semana × dia da semana. Nas linhas de total
// ele fica vazio e a célula sai limpa, em vez de somar dia do mês.
MEASURE '_Medidas'[Célula do calendário] =
    VAR Dia = SELECTEDVALUE ( dim_calendario[dia] )
    VAR Itens = [Agenda do dia]
    RETURN
        IF (
            ISBLANK ( Dia ),
            BLANK (),
            FORMAT ( Dia, "0" )
                & IF ( ISBLANK ( Itens ), "", UNICHAR ( 10 ) & Itens )
        )

// ------------------------------------------------------------------
// QUIZ
// ------------------------------------------------------------------

MEASURE '_Medidas'[Participações] =
    COUNTROWS ( fato_quiz_participacao )

MEASURE '_Medidas'[Participações concluídas] =
    CALCULATE ( [Participações], fato_quiz_participacao[concluida] = TRUE () )

MEASURE '_Medidas'[Participantes únicos] =
    DISTINCTCOUNT ( fato_quiz_participacao[colaborador_id] )

MEASURE '_Medidas'[Rodadas] =
    DISTINCTCOUNT ( fato_quiz_participacao[rodada_id] )

// Elegibilidade já vem resolvida da view (área da rodada + role
// colaborador). Recalcular em DAX duplicaria a regra.
MEASURE '_Medidas'[Taxa de participação] =
    DIVIDE (
        SUM ( fato_quiz_rodada_participacao[concluidas] ),
        SUM ( fato_quiz_rodada_participacao[elegiveis] )
    )

MEASURE '_Medidas'[Aproveitamento médio] =
    AVERAGE ( fato_quiz_participacao[aproveitamento] )

MEASURE '_Medidas'[Pontos] =
    SUM ( fato_quiz_participacao[pontos] )

MEASURE '_Medidas'[Acertos] =
    SUM ( fato_quiz_participacao[acertos] )

MEASURE '_Medidas'[Erros] =
    SUM ( fato_quiz_participacao[erros] )

MEASURE '_Medidas'[Tempo médio por pergunta (s)] =
    AVERAGE ( fato_quiz_participacao[segundos_por_pergunta] )

// O tempo nunca vira ponto — ele existe só para desempatar. É o que impede
// o desafio de virar corrida de clique, com gente respondendo no chute
// para terminar antes.
MEASURE '_Medidas'[Tempo total (s)] =
    SUM ( fato_quiz_participacao[tempo_segundos] )

// A ordem oficial do campeonato, a mesma de ordenarClassificacao() em
// src/lib/quiz.ts: 1) mais pontos, 2) mais acertos, 3) menos tempo,
// 4) quem concluiu primeiro. Se a regra mudar lá, mude aqui — senão o BI
// e a tela do app passam a discordar sobre quem está na frente.
//
// RANKX resolve um critério só e devolveria empate onde o app já tem um
// vencedor. Por isso a posição é contada à mão: quantos colaboradores
// estão à minha frente pela regra completa, mais um. Sobre dezenas ou
// centenas de participantes o custo é irrelevante, e o resultado é exato
// — sem chave numérica composta, que estouraria a precisão do double ao
// empilhar pontos, acertos, tempo e data num número só.
MEASURE '_Medidas'[Posição na temporada] =
    VAR SemTempo = 1000000000
    VAR SemFim = DATE ( 9999, 12, 31 )
    // ALLSELECTED sozinho tira do contexto só a coluna colaborador. A
    // tabela do ranking também traz area_rotulo, e esse filtro sobrevivia:
    // cada linha era comparada apenas com gente da MESMA área, e saíam dois
    // primeiros lugares — um do Armazém, outro da Distribuição. O
    // ALLSELECTED da área devolve as áreas que a segmentação deixou
    // passar, anulando só o filtro que vem da linha do visual.
    VAR Base =
        CALCULATETABLE (
            ADDCOLUMNS (
                ALLSELECTED ( fato_quiz_participacao[colaborador] ),
                "@Pontos", [Pontos],
                "@Acertos", [Acertos],
                "@Tempo", COALESCE ( [Tempo total (s)], SemTempo ),
                "@Fim", COALESCE ( CALCULATE ( MAX ( fato_quiz_participacao[concluida_em] ) ), SemFim )
            ),
            ALLSELECTED ( fato_quiz_participacao[area_rotulo] )
        )
    VAR MeusPontos = [Pontos]
    VAR MeusAcertos = [Acertos]
    VAR MeuTempo = COALESCE ( [Tempo total (s)], SemTempo )
    VAR MeuFim = COALESCE ( MAX ( fato_quiz_participacao[concluida_em] ), SemFim )
    VAR NaMinhaFrente =
        COUNTROWS (
            FILTER (
                Base,
                NOT ISBLANK ( [@Pontos] )
                    && (
                        [@Pontos] > MeusPontos
                            || ( [@Pontos] = MeusPontos && [@Acertos] > MeusAcertos )
                            || ( [@Pontos] = MeusPontos
                                && [@Acertos] = MeusAcertos
                                && [@Tempo] < MeuTempo )
                            || ( [@Pontos] = MeusPontos
                                && [@Acertos] = MeusAcertos
                                && [@Tempo] = MeuTempo
                                && [@Fim] < MeuFim )
                    )
            )
        )
    RETURN
        IF ( NOT ISBLANK ( MeusPontos ), NaMinhaFrente + 1 )

// Medalha como TEXTO, e não como formatação condicional de célula.
// Duas razões: o emoji sobrevive a exportação para Excel e PDF, onde a
// cor de fundo se perde; e formatação condicional por valor de categoria
// exige um seletor no PBIR cuja forma eu não consegui verificar — errar
// ali trava o arquivo inteiro por um ganho estético.
MEASURE '_Medidas'[Medalha] =
    SWITCH (
        [Posição na temporada],
        1, "🥇",
        2, "🥈",
        3, "🥉",
        ""
    )

// Use fato_quiz_resposta, e NÃO os contadores de dim_quiz_questao:
// aqueles são vitalícios e ignoram filtro de data.
MEASURE '_Medidas'[Taxa de erro (período)] =
    DIVIDE (
        CALCULATE (
            COUNTROWS ( fato_quiz_resposta ),
            fato_quiz_resposta[errou] = TRUE ()
        ),
        COUNTROWS ( fato_quiz_resposta )
    )

// Corte de 5 respostas: sem ele, uma pergunta respondida uma vez por
// alguém que errou aparece como 100% de erro no topo da lista.
MEASURE '_Medidas'[Questões críticas] =
    VAR Questoes =
        ADDCOLUMNS (
            VALUES ( fato_quiz_resposta[questao_id] ),
            "@Erro", [Taxa de erro (período)],
            "@Respostas", CALCULATE ( COUNTROWS ( fato_quiz_resposta ) )
        )
    RETURN
        COUNTROWS ( FILTER ( Questoes, [@Erro] > 0.4 && [@Respostas] >= 5 ) )

// ------------------------------------------------------------------
// SUPER MATINAL
// ------------------------------------------------------------------
// Só disciplina de publicação -- ranking e pontuação não existem no
// banco (a pontuação está dentro da imagem). Ver LEIA-ME.md, "Lacunas".

MEASURE '_Medidas'[Quadros publicados] =
    COUNTROWS ( fato_ranking_matinal )

MEASURE '_Medidas'[Meses com publicação] =
    DISTINCTCOUNT ( fato_ranking_matinal[mes_ano] )

MEASURE '_Medidas'[% Cobertura da publicação] =
    DIVIDE (
        CALCULATE (
            COUNTROWS ( fato_ranking_matinal_cobertura ),
            fato_ranking_matinal_cobertura[publicado] = TRUE ()
        ),
        COUNTROWS ( fato_ranking_matinal_cobertura )
    )

// ------------------------------------------------------------------
// PROGRAMA 5S
// ------------------------------------------------------------------
// A conformidade NÃO é recalculada aqui. Ela vem consolidada da view,
// que por sua vez lê o que o app gravou quando a auditoria foi
// finalizada -- a regra mora em public.cinco_s_taxa e em lugar nenhum
// mais. Reescrevê-la em DAX daria uma segunda fórmula para manter em
// dia, e no dia em que a operação decidisse tratar "N/A" de outro jeito,
// a tela do celular e o relatório passariam a discordar sem aviso.
//
// O que as medidas fazem é SOMAR os itens e dividir -- que é o jeito
// certo de agregar percentual. Fazer AVERAGE da conformidade das
// auditorias trataria uma área com 4 itens avaliados igual a outra com
// 25, e a média da revenda sairia errada sempre que uma área marcasse
// muito "não se aplica".

MEASURE '_Medidas'[Itens conformes] =
    SUM ( fato_5s_auditoria[itens_ok] )

MEASURE '_Medidas'[Itens não conformes] =
    SUM ( fato_5s_auditoria[itens_nok] )

MEASURE '_Medidas'[Itens avaliados] =
    SUM ( fato_5s_auditoria[itens_avaliados] )

MEASURE '_Medidas'[% Conformidade 5S] =
    DIVIDE ( [Itens conformes], [Itens avaliados] )

MEASURE '_Medidas'[Auditorias planejadas] =
    COUNTROWS ( fato_5s_auditoria )

MEASURE '_Medidas'[Auditorias realizadas] =
    CALCULATE (
        COUNTROWS ( fato_5s_auditoria ),
        fato_5s_auditoria[realizada] = TRUE ()
    )

MEASURE '_Medidas'[Auditorias pendentes] =
    [Auditorias planejadas] - [Auditorias realizadas]

// Aderência é o indicador que sustenta todos os outros: 95% de
// conformidade em 3 áreas de 19 auditadas não diz nada sobre a revenda.
//
// SÓ O QUE JÁ VENCEU ENTRA NA CONTA.
//
// A versão anterior dividia realizadas por TODAS as planejadas do
// período filtrado -- inclusive as agendadas para depois de hoje. Com o
// filtro aberto no ano, o plano de novembro e dezembro entrava no
// denominador e a aderência aparecia bem abaixo de 100% mesmo com o
// ciclo em dia. O indicador acusava atraso em auditoria que ainda nem
// tinha chegado a data.
//
// Auditoria com data futura não é auditoria em falta: é compromisso. As
// duas variáveis abaixo recortam o mesmo universo -- o que já venceu --
// para numerador e denominador, então uma auditoria antecipada não
// empurra o número acima de 100%.
MEASURE '_Medidas'[% Aderência ao plano] =
    VAR Vencidas =
        CALCULATE (
            COUNTROWS ( fato_5s_auditoria ),
            fato_5s_auditoria[data] <= TODAY ()
        )
    VAR VencidasFeitas =
        CALCULATE (
            COUNTROWS ( fato_5s_auditoria ),
            fato_5s_auditoria[data] <= TODAY (),
            fato_5s_auditoria[realizada] = TRUE ()
        )
    RETURN
        DIVIDE ( VencidasFeitas, Vencidas )

MEASURE '_Medidas'[Auditorias atrasadas] =
    CALCULATE (
        COUNTROWS ( fato_5s_auditoria ),
        fato_5s_auditoria[atrasada] = TRUE ()
    )

MEASURE '_Medidas'[Áreas auditadas] =
    CALCULATE (
        DISTINCTCOUNT ( fato_5s_auditoria[area_5s_id] ),
        fato_5s_auditoria[realizada] = TRUE ()
    )

// Áreas que existem e não foram auditadas no período. É o buraco que
// nenhum gráfico de conformidade mostra -- área não auditada não puxa
// média nenhuma para baixo, ela simplesmente some do relatório.
MEASURE '_Medidas'[Áreas sem auditoria] =
    VAR Ativas =
        CALCULATE ( DISTINCTCOUNT ( dim_5s_area[area_5s_id] ), dim_5s_area[ativa] = TRUE () )
    RETURN Ativas - [Áreas auditadas]

MEASURE '_Medidas'[% Conformidade mês anterior] =
    CALCULATE ( [% Conformidade 5S], DATEADD ( dim_calendario[data], -1, MONTH ) )

MEASURE '_Medidas'[Δ Conformidade 5S] =
    VAR Atual = [% Conformidade 5S]
    VAR Anterior = [% Conformidade mês anterior]
    RETURN IF ( NOT ISBLANK ( Anterior ), Atual - Anterior )

// ---- Plano de ação ----

MEASURE '_Medidas'[Não conformidades] =
    COUNTROWS ( fato_5s_acao )

MEASURE '_Medidas'[NC em aberto] =
    CALCULATE ( COUNTROWS ( fato_5s_acao ), fato_5s_acao[em_aberto] = TRUE () )

MEASURE '_Medidas'[NC resolvidas] =
    CALCULATE ( COUNTROWS ( fato_5s_acao ), fato_5s_acao[resolvida] = TRUE () )

MEASURE '_Medidas'[Ações atrasadas] =
    CALCULATE ( COUNTROWS ( fato_5s_acao ), fato_5s_acao[atrasada] = TRUE () )

MEASURE '_Medidas'[% Ações concluídas] =
    DIVIDE ( [NC resolvidas], [Não conformidades] )

// Só o que foi concluído entra na média. Incluir o que ainda está aberto
// faria o número parecer melhor justamente quando piora: a ação parada
// há 90 dias não tem data de conclusão e ficaria de fora da conta.
MEASURE '_Medidas'[Dias médios para resolver] =
    AVERAGE ( fato_5s_acao[dias_para_resolver] )

// ---- Itens críticos ----

MEASURE '_Medidas'[Respostas NOK] =
    SUM ( fato_5s_resposta[eh_nok] )

MEASURE '_Medidas'[Respostas avaliadas] =
    SUM ( fato_5s_resposta[eh_avaliado] )

MEASURE '_Medidas'[% Reprovação do item] =
    DIVIDE ( [Respostas NOK], [Respostas avaliadas] )

// Corte de 5 avaliações, mesmo critério do quiz: sem ele, um item
// respondido uma única vez e reprovado aparece como 100% de reprovação
// no topo do ranking e a lista perde utilidade.
MEASURE '_Medidas'[Itens críticos] =
    VAR Itens =
        ADDCOLUMNS (
            VALUES ( dim_5s_pergunta[pergunta_5s_id] ),
            "@Reprova", [% Reprovação do item],
            "@Avaliadas", [Respostas avaliadas]
        )
    RETURN
        COUNTROWS ( FILTER ( Itens, [@Reprova] > 0.3 && [@Avaliadas] >= 5 ) )

// ---- Conformidade por senso (para o radar) ----

MEASURE '_Medidas'[% Conformidade do senso] =
    DIVIDE (
        SUM ( fato_5s_senso[itens_ok] ),
        SUM ( fato_5s_senso[itens_avaliados] )
    )

// O senso com o pior resultado no recorte. Responde em um cartão a
// pergunta que o radar responde em cinco segundos de leitura.
MEASURE '_Medidas'[Senso mais crítico] =
    VAR PorSenso =
        ADDCOLUMNS (
            VALUES ( fato_5s_senso[senso_rotulo] ),
            "@Taxa", [% Conformidade do senso]
        )
    VAR Pior = MINX ( PorSenso, [@Taxa] )
    RETURN
        CONCATENATEX (
            FILTER ( PorSenso, [@Taxa] = Pior ),
            fato_5s_senso[senso_rotulo], ", "
        )

// Quanto do histórico veio de medição de verdade. Os meses cujo registro
// se perdeu entraram por estimativa (ver migração 039); esta medida é o
// que permite dizer, em qualquer recorte, sobre quanta medição real o
// número está apoiado.
MEASURE '_Medidas'[% Auditorias medidas] =
    DIVIDE (
        CALCULATE (
            COUNTROWS ( fato_5s_auditoria ),
            fato_5s_auditoria[estimada] = FALSE (),
            fato_5s_auditoria[realizada] = TRUE ()
        ),
        [Auditorias realizadas]
    )

// ==================================================================
// PRODUTIVIDADE DO ARMAZÉM
// ==================================================================
// Regra que vale para o bloco inteiro: TAXA É DIVISÃO DE SOMAS, nunca
// média de taxas. Uma "média de caixas por hora" calculada sobre a
// coluna taxa_hora daria o mesmo peso a um lançamento de 2 minutos e a
// um de 6 horas — e é justamente o lançamento curto que tem a taxa
// absurda. Por isso toda taxa aqui é DIVIDE( SUM(qtd), SUM(horas) ).

// ------------------------------------------------------------------
// BANCADA — SELEÇÃO E REPACK
// ------------------------------------------------------------------

MEASURE '_Medidas'[Horas de bancada] =
    SUM ( fato_pa_bancada[horas] )

MEASURE '_Medidas'[Caixas repackadas] =
    SUM ( fato_pa_bancada[caixas] )

MEASURE '_Medidas'[Unidades triadas] =
    SUM ( fato_pa_bancada[unidades_triadas] )

// Só as horas da etapa de repack no denominador. Somar as horas de
// triagem derrubaria a taxa de quem embala e faria parecer queda de
// ritmo o que foi só um lote muito avariado.
MEASURE '_Medidas'[Repack cx/h] =
    DIVIDE (
        [Caixas repackadas],
        CALCULATE ( SUM ( fato_pa_bancada[horas] ), fato_pa_bancada[etapa] = "repack" )
    )

MEASURE '_Medidas'[Seleção un/h] =
    DIVIDE (
        [Unidades triadas],
        CALCULATE ( SUM ( fato_pa_bancada[horas] ), fato_pa_bancada[etapa] = "selecao" )
    )

// O número que motivou separar as duas etapas: se a triagem passar a
// puxar a maior fatia, o gargalo está na qualidade do que CHEGA, não na
// velocidade de quem embala.
MEASURE '_Medidas'[% do tempo na triagem] =
    DIVIDE (
        CALCULATE ( SUM ( fato_pa_bancada[horas] ), fato_pa_bancada[etapa] = "selecao" ),
        [Horas de bancada]
    )

// Por dia TRABALHADO, não por dia do período. Contar domingo e dia sem
// lançamento faria a bancada parecer ociosa quando ela só não operou.
MEASURE '_Medidas'[Bancada h/dia] =
    DIVIDE ( [Horas de bancada], DISTINCTCOUNT ( fato_pa_bancada[data] ) )

MEASURE '_Medidas'[Lançamentos de bancada] =
    COUNTROWS ( fato_pa_bancada )

// Duração média por CAIXA, não por lançamento — é a mesma conta do
// cartão do app. Um lançamento pode ter 2 caixas ou 20, então "duração
// média do lançamento" mistura sessões de tamanhos muito diferentes.
// Em MINUTOS porque em horas o número sai "0,04h", que não se lê nem se
// cadastra como meta.
MEASURE '_Medidas'[Minutos por caixa] =
    DIVIDE (
        CALCULATE ( SUM ( fato_pa_bancada[horas] ), fato_pa_bancada[etapa] = "repack" ) * 60,
        [Caixas repackadas]
    )

MEASURE '_Medidas'[Dias com bancada] =
    DISTINCTCOUNT ( fato_pa_bancada[data] )

// ------------------------------------------------------------------
// DESPEJO E A BOMBONA
// ------------------------------------------------------------------

MEASURE '_Medidas'[Litros despejados] =
    SUM ( fato_pa_despejo[litros] )

MEASURE '_Medidas'[Litros por hora] =
    DIVIDE ( [Litros despejados], SUM ( fato_pa_despejo[horas] ) )

MEASURE '_Medidas'[Lançamentos de despejo] =
    COUNTROWS ( fato_pa_despejo )

MEASURE '_Medidas'[Horas de despejo] =
    SUM ( fato_pa_despejo[horas] )

/*
    A BOMBONA IGNORA OS FILTROS, e isso é o desenho, não um descuido.

    Ela é um recipiente físico: não tem turno, não tem dono e não existe
    "quanto tinha nela em agosto". Filtrada por turno, o T1 veria a
    bombona pela metade e o T2 vazia — sendo a MESMA bombona.

    REMOVEFILTERS só no calendário, no colaborador e na hora. A REVENDA
    continua valendo: cada revenda tem a sua bombona, e somar as duas
    daria um nível que não existe em lugar nenhum.
*/
MEASURE '_Medidas'[Na bombona (L)] =
    CALCULATE (
        SUM ( fato_pa_bombona[litros_agora] ),
        REMOVEFILTERS ( dim_calendario ),
        REMOVEFILTERS ( dim_colaborador ),
        REMOVEFILTERS ( dim_hora )
    )

MEASURE '_Medidas'[% da bombona] =
    VAR Nivel = [Na bombona (L)]
    VAR Cap =
        CALCULATE (
            SUM ( fato_pa_bombona[capacidade] ),
            REMOVEFILTERS ( dim_calendario ),
            REMOVEFILTERS ( dim_colaborador ),
            REMOVEFILTERS ( dim_hora )
        )
    RETURN
        DIVIDE ( Nivel, Cap )

// Bombona parada cheia é risco ambiental; esvaziada pela metade é
// viagem desperdiçada. Os dois lados são decisão, e nenhum dos dois
// aparece em "litros despejados no mês".
MEASURE '_Medidas'[Dias sem esvaziar] =
    CALCULATE (
        MAX ( fato_pa_bombona[dias_desde_esvaziamento] ),
        REMOVEFILTERS ( dim_calendario ),
        REMOVEFILTERS ( dim_colaborador ),
        REMOVEFILTERS ( dim_hora )
    )

// Com quanto a bombona costuma ir para o descarte. Muito abaixo de 100%
// é viagem sobrando na rota do resíduo.
MEASURE '_Medidas'[% médio no descarte] =
    AVERAGE ( fato_pa_esvaziamento[pct_no_descarte] )

MEASURE '_Medidas'[Descartes] =
    COUNTROWS ( fato_pa_esvaziamento )

// ------------------------------------------------------------------
// ABASTECIMENTO E RESSUPRIMENTO
// ------------------------------------------------------------------

MEASURE '_Medidas'[HL abastecidos] =
    SUM ( fato_pa_abastecimento[hl] )

MEASURE '_Medidas'[HL por hora] =
    DIVIDE ( [HL abastecidos], SUM ( fato_pa_abastecimento[horas] ) )

MEASURE '_Medidas'[Sessões de abastecimento] =
    COUNTROWS ( fato_pa_abastecimento )

MEASURE '_Medidas'[Ressuprimentos] =
    COUNTROWS ( fato_pa_ressuprimento )

// AVERAGE ignora o nulo, então só os pedidos CONCLUÍDOS entram: um
// pedido em aberto tem ciclo nulo, e tratá-lo como zero faria a
// operação parecer instantânea.
MEASURE '_Medidas'[Ciclo médio (min)] =
    AVERAGE ( fato_pa_ressuprimento[ciclo_min] )

MEASURE '_Medidas'[Espera pela empilhadeira (min)] =
    AVERAGE ( fato_pa_ressuprimento[espera_empilhadeira_min] )

MEASURE '_Medidas'[Transporte (min)] =
    AVERAGE ( fato_pa_ressuprimento[transporte_min] )

MEASURE '_Medidas'[Espera pelo ajudante (min)] =
    AVERAGE ( fato_pa_ressuprimento[espera_ajudante_min] )

// O número que muda decisão: um ciclo de 40 minutos com 35 de espera
// não se resolve treinando quem abastece.
MEASURE '_Medidas'[% do ciclo esperando] =
    DIVIDE (
        SUM ( fato_pa_ressuprimento[espera_empilhadeira_min] )
            + SUM ( fato_pa_ressuprimento[espera_ajudante_min] ),
        SUM ( fato_pa_ressuprimento[ciclo_min] )
    )

// Se "urgente" for a maioria, o campo perdeu o significado — e a fila
// voltou a ser ordem de chegada com outro nome.
MEASURE '_Medidas'[% urgentes] =
    DIVIDE (
        CALCULATE (
            COUNTROWS ( fato_pa_ressuprimento ),
            fato_pa_ressuprimento[prioridade] = "urgente"
        ),
        [Ressuprimentos]
    )

MEASURE '_Medidas'[% cancelados] =
    DIVIDE (
        CALCULATE (
            COUNTROWS ( fato_pa_ressuprimento ),
            fato_pa_ressuprimento[cancelado] = TRUE ()
        ),
        [Ressuprimentos]
    )

// ------------------------------------------------------------------
// BATE PALETE
// ------------------------------------------------------------------

MEASURE '_Medidas'[HL batidos] =
    SUM ( fato_pa_bate_palete[hl_batido] )

MEASURE '_Medidas'[HL avariados] =
    SUM ( fato_pa_bate_palete[hl_avariado] )

// Soma sobre soma. A média dos percentuais trataria um lote de 2 HL
// igual a um de 200 — e o lote pequeno é sempre o de percentual extremo.
MEASURE '_Medidas'[% avaria no bate palete] =
    DIVIDE ( [HL avariados], [HL batidos] )

// ==================================================================
// RECEBIMENTO DE CARRETAS
// ==================================================================

MEASURE '_Medidas'[Carretas finalizadas] =
    COUNTROWS ( fato_carreta )

MEASURE '_Medidas'[TMA médio (min)] =
    AVERAGE ( fato_carreta[tma_min] )

/*
    A CAUDA, e não só a média.

    A média é o número que se cobra; o P90 é o que a transportadora
    sente. Vinte carretas em 60 min e duas em 300 dão uma média de 82
    que ninguém reconhece — e são as duas de 300 que geram a reclamação
    e a multa de estadia.

    PERCENTILEX.INC e não .EXC: com poucas carretas no recorte, a versão
    exclusiva devolve erro em vez de número, e cartão em branco no meio
    de uma reunião não se explica.
*/
MEASURE '_Medidas'[TMA mediano (min)] =
    PERCENTILEX.INC ( fato_carreta, fato_carreta[tma_min], 0.5 )

MEASURE '_Medidas'[TMA P90 (min)] =
    PERCENTILEX.INC ( fato_carreta, fato_carreta[tma_min], 0.9 )

// Dá para a MÉDIA bater com metade das carretas estourando, desde que a
// outra metade seja muito rápida. O percentual é o que a operação
// sente; a média é o que o relatório diz.
MEASURE '_Medidas'[% dentro da meta de TMA] =
    DIVIDE (
        CALCULATE ( COUNTROWS ( fato_carreta ), fato_carreta[dentro_da_meta] = TRUE () ),
        CALCULATE ( COUNTROWS ( fato_carreta ), NOT ISBLANK ( fato_carreta[tma_min] ) )
    )

// A outra face do "% dentro da meta" — pedida pelo dono em 10/09/2026,
// e é a que se leva para a conversa: "14 carretas estouraram a meta"
// é uma frase que gera ação; "82% dentro" é uma que gera aceno.
//
// FALSE() e não NOT TRUE(): carreta sem TMA medido tem dentro_da_meta
// NULO, e ela não estourou meta nenhuma — só não foi medida. NOT TRUE()
// a contaria como fora e inflaria o número exatamente com as carretas
// de apontamento incompleto.
MEASURE '_Medidas'[Carretas fora da meta] =
    CALCULATE ( COUNTROWS ( fato_carreta ), fato_carreta[dentro_da_meta] = FALSE () )

// Mesmo denominador do "% dentro": só carretas com TMA medido. As duas
// somam 100% — e é por isso que a página mostra uma e não as duas.
MEASURE '_Medidas'[% fora da meta de TMA] =
    DIVIDE (
        [Carretas fora da meta],
        CALCULATE ( COUNTROWS ( fato_carreta ), NOT ISBLANK ( fato_carreta[tma_min] ) )
    )

// A régua é a cadastrada em Admin > Recebimento e viaja na linha do
// fato. Quando ela mudar, o BI acompanha sozinho.
MEASURE '_Medidas'[Meta de TMA (min)] =
    AVERAGE ( fato_carreta[tma_alvo_min] )

MEASURE '_Medidas'[Espera na portaria (min)] =
    AVERAGE ( fato_carreta[espera_portaria_min] )

MEASURE '_Medidas'[Descarga (min)] =
    AVERAGE ( fato_carreta[descarga_min] )

// NÃO entra no TMA: a carreta não espera pela conferência. Já houve
// conferência terminando duas horas depois de a carreta sair.
MEASURE '_Medidas'[Conferência (min)] =
    AVERAGE ( fato_carreta[conferencia_min] )

MEASURE '_Medidas'[Pátio (min)] =
    AVERAGE ( fato_carreta[patio_min] )

/*
    O ATRASO DO TRANSPORTADOR — o dado que estava no banco desde a
    migração 057 e nunca tinha sido comparado.

    Separa "a carreta atrasou" de "a operação demorou", que hoje se
    confundem dentro do TMA. É a conversa que se tem com a
    transportadora, e não com o conferente.

    Só carretas COM agendamento entram no denominador: sem horário
    combinado não existe atraso, e contá-las diluiria o número de quem
    realmente atrasa.
*/
MEASURE '_Medidas'[Atraso do transportador (min)] =
    AVERAGE ( fato_carreta[atraso_chegada_min] )

MEASURE '_Medidas'[% carretas atrasadas] =
    DIVIDE (
        CALCULATE ( COUNTROWS ( fato_carreta ), fato_carreta[atraso_chegada_min] > 0 ),
        CALCULATE ( COUNTROWS ( fato_carreta ), fato_carreta[tinha_agendamento] = TRUE () )
    )

MEASURE '_Medidas'[Paletes recebidos] =
    SUM ( fato_carreta[paletes_recebidos] )

MEASURE '_Medidas'[Paletes avariados] =
    SUM ( fato_carreta[paletes_avariados] )

/*
    A conferência conta em PALETES, e um palete com uma garrafa quebrada
    conta inteiro. Por isso o número fica na casa das dezenas de %: ele
    diz quantos paletes foram TOCADOS por avaria, não quanto do volume
    veio avariado.

    Só carretas com conferência lançada entram — sem conferência não há
    avaria medida, e incluí-las puxaria o percentual para baixo fingindo
    que nada veio avariado.
*/
MEASURE '_Medidas'[% de avaria] =
    DIVIDE (
        CALCULATE ( [Paletes avariados], fato_carreta[teve_conferencia] = TRUE () ),
        CALCULATE ( [Paletes recebidos], fato_carreta[teve_conferencia] = TRUE () )
    )

MEASURE '_Medidas'[Carretas conferidas] =
    CALCULATE ( COUNTROWS ( fato_carreta ), fato_carreta[teve_conferencia] = TRUE () )

// A avaria aberta por PRODUTO. Vem do grão item, que é o que aponta a
// origem: um SKU que chega avariado em todo lote tem problema de
// paletização ou de transporte, e nada dentro do armazém resolve.
MEASURE '_Medidas'[% de avaria por produto] =
    DIVIDE (
        SUM ( fato_carreta_item[paletes_avariados] ),
        SUM ( fato_carreta_item[paletes_recebidos] )
    )

// ==================================================================
// EMPILHADEIRA
// ==================================================================

// Do HORÍMETRO (motor rodando), nunca do relógio. Quem abre às 6h e
// fecha às 15h pode ter rodado três horas — e a diferença entre os dois
// números é a diferença entre "a máquina foi usada" e "a máquina estava
// com alguém".
MEASURE '_Medidas'[Horas de horímetro] =
    SUM ( fato_empilhadeira_operacao[horas_ativas] )

MEASURE '_Medidas'[Operações encerradas] =
    CALCULATE (
        COUNTROWS ( fato_empilhadeira_operacao ),
        fato_empilhadeira_operacao[encerrada] = TRUE ()
    )

MEASURE '_Medidas'[Operações em aberto] =
    CALCULATE (
        COUNTROWS ( fato_empilhadeira_operacao ),
        fato_empilhadeira_operacao[encerrada] = FALSE ()
    )

// Encerradas no denominador, e não todas: quem conferir dividindo as
// horas por este número tem de chegar na média mostrada ao lado. Um
// indicador que não fecha na conferência do usuário perde a confiança
// dele de uma vez só.
MEASURE '_Medidas'[Duração média (h)] =
    DIVIDE ( [Horas de horímetro], [Operações encerradas] )

/*
    Quanto da operação a máquina ficou LIGADA.

    Abaixo de uns 30% quase nunca é máquina ociosa: é operação aberta e
    esquecida. A leitura muda de "sobra empilhadeira" para "falta fechar
    apontamento", que são decisões opostas — uma corta máquina do
    contrato, a outra treina o operador.
*/
MEASURE '_Medidas'[% aproveitamento do apontamento] =
    DIVIDE (
        [Horas de horímetro],
        CALCULATE (
            SUM ( fato_empilhadeira_operacao[horas_de_relogio] ),
            fato_empilhadeira_operacao[encerrada] = TRUE ()
        )
    )

// Não é produtividade, é qualidade do apontamento: quando o líder fecha
// no dia seguinte, o horímetro final é o que ele achou na máquina e
// todo o consumo do intervalo vai para quem abriu. É o número que diz
// quanta confiança os indicadores por operador merecem.
MEASURE '_Medidas'[Encerradas por terceiro] =
    CALCULATE (
        COUNTROWS ( fato_empilhadeira_operacao ),
        fato_empilhadeira_operacao[encerrada_por_terceiro] = TRUE ()
    )

MEASURE '_Medidas'[Trocas de P20] =
    COUNTROWS ( fato_empilhadeira_gas )

// Custo do gás pelas TROCAS do período — não pelo ciclo (esse atravessa
// turnos e não vem para o BI, ver a view). É quanto botijão foi posto na
// máquina no recorte, que é o que sai do caixa.
MEASURE '_Medidas'[Custo do gás (R$)] =
    SUMX ( fato_empilhadeira_gas, fato_empilhadeira_gas[custo_p20] )

/*
    QUANTO RENDE UM BOTIJÃO — a média dos ciclos fechados.

    Vem de fato_empilhadeira_ciclo_gas, que é um RELATÓRIO: cada linha é
    um ciclo com início, fim e horas. A média aqui é honesta enquanto se
    olha máquina e período; recortada por turno ou por operador, ela
    passa a somar pedaços de ciclos diferentes e o botijão parece render
    mais do que rende. Por isso a tabela do ciclo não liga em dim_hora
    nem em dim_colaborador — ver a nota da view.
*/
MEASURE '_Medidas'[Horas por botijão] =
    AVERAGE ( fato_empilhadeira_ciclo_gas[horas_do_botijao] )

// Junto das horas, separa "rendeu pouco" de "a máquina rodou muito":
// 8h em dois dias e 8h em duas semanas são operações diferentes com o
// mesmo consumo.
MEASURE '_Medidas'[Dias por botijão] =
    AVERAGE ( fato_empilhadeira_ciclo_gas[dias_do_botijao] )

MEASURE '_Medidas'[Botijões fechados] =
    COUNTROWS ( fato_empilhadeira_ciclo_gas )

// ==================================================================
// DESAFIO DO MÊS — o que a análise nova passou a olhar
// ==================================================================

MEASURE '_Medidas'[Respostas] =
    COUNTROWS ( fato_quiz_resposta )

MEASURE '_Medidas'[Taxa de acerto] =
    DIVIDE (
        CALCULATE ( COUNTROWS ( fato_quiz_resposta ), fato_quiz_resposta[correta] = TRUE () ),
        [Respostas]
    )

/*
    CHUTE: errou E respondeu em menos de quatro segundos.

    Errar depois de pensar é falta de conhecimento e se treina; errar em
    quatro segundos é pressa. Cobrar conteúdo de quem só clicou rápido
    treina a coisa errada — e uma taxa de chute alta diz que o problema
    é o MOMENTO em que o desafio está sendo respondido, não o conteúdo.
    Cruze com dim_hora: costuma ser fim de turno.
*/
MEASURE '_Medidas'[Chutes] =
    CALCULATE ( COUNTROWS ( fato_quiz_resposta ), fato_quiz_resposta[chute] = TRUE () )

MEASURE '_Medidas'[% de chute] =
    DIVIDE ( [Chutes], [Respostas] )

// Abaixo de 60% a pergunta deixa de ser placar e vira pauta: metade do
// time não sabe o procedimento. O corte espelha ALERTA_DE_ACERTO em
// src/lib/desafio-analise.ts.
//
// Mínimo de 5 respostas junto: sem ele, uma pergunta respondida uma
// única vez por quem errou entra como "pergunta crítica" e o número
// perde credibilidade na primeira reunião.
MEASURE '_Medidas'[Perguntas em alerta] =
    VAR PorPergunta =
        ADDCOLUMNS (
            SUMMARIZE ( fato_quiz_resposta, fato_quiz_resposta[questao_id] ),
            "@Acerto", [Taxa de acerto],
            "@Qtd", [Respostas]
        )
    RETURN
        COUNTROWS ( FILTER ( PorPergunta, [@Acerto] < 0.6 && [@Qtd] >= 5 ) )

// O padrão de origem com pior acerto no recorte. É a pauta de
// treinamento com endereço: "62% de acerto" é uma nota; "62% no
// POP-ARM-001" é uma ação com responsável.
MEASURE '_Medidas'[Padrão mais crítico] =
    VAR PorPadrao =
        ADDCOLUMNS (
            SUMMARIZE ( fato_quiz_resposta, fato_quiz_resposta[origem] ),
            "@Acerto", [Taxa de acerto],
            "@Qtd", [Respostas]
        )
    VAR Elegiveis = FILTER ( PorPadrao, [@Qtd] >= 5 )
    VAR Pior = MINX ( Elegiveis, [@Acerto] )
    RETURN
        CONCATENATEX (
            FILTER ( Elegiveis, [@Acerto] = Pior ),
            fato_quiz_resposta[origem], ", "
        )

EVALUATE
    { "Medidas aplicadas. Pode apagar esta consulta." }
