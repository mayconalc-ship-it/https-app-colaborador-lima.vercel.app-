/// Explodido: um feedback com 3 ocorrencias vira 3 linhas. Conte DISTINCT feedback_id.
table fato_feedback_ocorrencia
	lineageTag: 6848f3ea-ffcb-4bd8-9175-628bd6f96132

	column feedback_id
		dataType: string
		isHidden
		lineageTag: 855b2c07-bbe4-4c89-b35d-9e1d2cb80adc
		summarizeBy: none
		sourceColumn: feedback_id

		annotation SummarizationSetBy = Automatic

