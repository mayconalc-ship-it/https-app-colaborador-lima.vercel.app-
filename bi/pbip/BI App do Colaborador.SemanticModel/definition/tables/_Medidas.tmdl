		formatString: 0.0%
		lineageTag: ca19cf40-ea14-4705-94e0-6967759754e6

	measure 'Auditorias planejadas' = COUNTROWS ( fato_5s_auditoria )
		formatString: #,0
		lineageTag: ea642328-21a8-4880-a1ab-e04044fc3393

	measure 'Auditorias realizadas' =
