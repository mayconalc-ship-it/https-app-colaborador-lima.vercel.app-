		lineageTag: 27638df8-90fc-4c21-8dc1-a3256d398e6d

	measure '% Cobertura da publicação' =
			DIVIDE (
			    CALCULATE (
			        COUNTROWS ( fato_ranking_matinal_cobertura ),
			        fato_ranking_matinal_cobertura[publicado] = TRUE ()
