			    COUNTROWS ( fato_5s_auditoria ),
			    fato_5s_auditoria[realizada] = TRUE ()
			)
		formatString: #,0
		lineageTag: 63372ee0-d22f-4f48-97aa-ceafd161d54a

	measure 'Auditorias pendentes' = [Auditorias planejadas] - [Auditorias realizadas]
		formatString: #,0
		lineageTag: 5dd4199e-a0aa-4403-a252-217c784ae144

	measure '% Aderência ao plano' =
			VAR Vencidas =
			    CALCULATE (
			        COUNTROWS ( fato_5s_auditoria ),
			        fato_5s_auditoria[data] <= TODAY ()
			    )
			VAR VencidasFeitas =
			    CALCULATE (
			        COUNTROWS ( fato_5s_auditoria ),
			        fato_5s_auditoria[data] <= TODAY (),
			        fato_5s_auditoria[realizada] = TRUE ()
			    )
			RETURN
			    DIVIDE ( VencidasFeitas, Vencidas )
		formatString: 0.0%
		lineageTag: 9eb20a42-5397-45ae-9a72-775a222b6ed8

	measure 'Auditorias atrasadas' =
			CALCULATE (
