	measure 'Itens críticos' =
			VAR Itens =
			    ADDCOLUMNS (
			        VALUES ( dim_5s_pergunta[pergunta_5s_id] ),
			        "@Reprova", [% Reprovação do item],
			        "@Avaliadas", [Respostas avaliadas]
			    )
			RETURN
			    COUNTROWS ( FILTER ( Itens, [@Reprova] > 0.3 && [@Avaliadas] >= 5 ) )
		formatString: #,0
		lineageTag: 0a3636dd-612b-495e-b89b-259cc2204a04

	measure '% Conformidade do senso' =
			DIVIDE (
			    SUM ( fato_5s_senso[itens_ok] ),
			    SUM ( fato_5s_senso[itens_avaliados] )
			)
		formatString: 0.0%
		lineageTag: a1e2842b-c8f2-4c12-a868-093bdabba0f4

	measure 'Senso mais crítico' =
			VAR PorSenso =
			    ADDCOLUMNS (
			        VALUES ( fato_5s_senso[senso_rotulo] ),
			        "@Taxa", [% Conformidade do senso]
			    )
			VAR Pior = MINX ( PorSenso, [@Taxa] )
			RETURN
			    CONCATENATEX (
			        FILTER ( PorSenso, [@Taxa] = Pior ),
			        fato_5s_senso[senso_rotulo], ", "
			    )
		formatString: #,0
		lineageTag: 483e0e28-3d0c-4521-9879-5b046cd29518

	measure '% Auditorias medidas' =
			DIVIDE (
			    CALCULATE (
			        COUNTROWS ( fato_5s_auditoria ),
			        fato_5s_auditoria[estimada] = FALSE (),
			        fato_5s_auditoria[realizada] = TRUE ()
			    ),
			    [Auditorias realizadas]
			)
		formatString: 0.0%
		lineageTag: a219fa5d-2cb3-48ba-98a9-e19065c5cf3c

