	measure Pontos = SUM ( fato_quiz_participacao[pontos] )
		formatString: #,0
		lineageTag: 6b413f1f-f123-4755-9f3c-84a02f0c541f

	measure Acertos = SUM ( fato_quiz_participacao[acertos] )
		formatString: #,0
		lineageTag: b5b99b10-b1d7-4085-bcf5-733fe280ee64

	measure Erros = SUM ( fato_quiz_participacao[erros] )
		formatString: #,0
		lineageTag: fe378b50-47df-416d-b2b0-d601cb484544

	measure 'Tempo médio por pergunta (s)' = AVERAGE ( fato_quiz_participacao[segundos_por_pergunta] )
		formatString: 0.0
		lineageTag: 93fb8b80-0f3f-4307-8b79-144a50814005

	measure 'Tempo total (s)' = SUM ( fato_quiz_participacao[tempo_segundos] )
		formatString: 0.0
		lineageTag: 723ffeaf-33f4-439c-9502-3808e8cc828a

	measure 'Posição na temporada' =
			VAR SemTempo = 1000000000
			VAR SemFim = DATE ( 9999, 12, 31 )
			// ALLSELECTED sozinho tira do contexto só a coluna colaborador. A
			// tabela do ranking também traz area_rotulo, e esse filtro sobrevivia:
			// cada linha era comparada apenas com gente da MESMA área, e saíam dois
			// primeiros lugares — um do Armazém, outro da Distribuição. O
			// ALLSELECTED da área devolve as áreas que a segmentação deixou
			// passar, anulando só o filtro que vem da linha do visual.
			VAR Base =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            ALLSELECTED ( fato_quiz_participacao[colaborador] ),
			            "@Pontos", [Pontos],
			            "@Acertos", [Acertos],
			            "@Tempo", COALESCE ( [Tempo total (s)], SemTempo ),
			            "@Fim", COALESCE ( CALCULATE ( MAX ( fato_quiz_participacao[concluida_em] ) ), SemFim )
			        ),
			        ALLSELECTED ( fato_quiz_participacao[area_rotulo] )
			    )
			VAR MeusPontos = [Pontos]
			VAR MeusAcertos = [Acertos]
			VAR MeuTempo = COALESCE ( [Tempo total (s)], SemTempo )
			VAR MeuFim = COALESCE ( MAX ( fato_quiz_participacao[concluida_em] ), SemFim )
			VAR NaMinhaFrente =
			    COUNTROWS (
			        FILTER (
			            Base,
			            NOT ISBLANK ( [@Pontos] )
			                && (
			                    [@Pontos] > MeusPontos
			                        || ( [@Pontos] = MeusPontos && [@Acertos] > MeusAcertos )
			                        || ( [@Pontos] = MeusPontos
			                            && [@Acertos] = MeusAcertos
			                            && [@Tempo] < MeuTempo )
			                        || ( [@Pontos] = MeusPontos
			                            && [@Acertos] = MeusAcertos
			                            && [@Tempo] = MeuTempo
			                            && [@Fim] < MeuFim )
			                )
			        )
			    )
			RETURN
			    IF ( NOT ISBLANK ( MeusPontos ), NaMinhaFrente + 1 )
		formatString: #,0
		lineageTag: 514b1969-e6ee-43a8-9cf1-6c176f17220b

	measure Medalha =
			SWITCH (
			    [Posição na temporada],
			    1, "🥇",
			    2, "🥈",
			    3, "🥉",
			    ""
			)
		formatString: #,0
		lineageTag: 3a46c596-fbce-42d2-b9ec-2d4dcbfedf84

	measure 'Taxa de erro (período)' =
			DIVIDE (
			    CALCULATE (
			        COUNTROWS ( fato_quiz_resposta ),
			        fato_quiz_resposta[errou] = TRUE ()
			    ),
			    COUNTROWS ( fato_quiz_resposta )
			)
		formatString: 0.0%
		lineageTag: f24d1994-59e2-4b82-9012-af8ad90c0b71

	measure 'Questões críticas' =
			VAR Questoes =
			    ADDCOLUMNS (
			        VALUES ( fato_quiz_resposta[questao_id] ),
			        "@Erro", [Taxa de erro (período)],
			        "@Respostas", CALCULATE ( COUNTROWS ( fato_quiz_resposta ) )
			    )
			RETURN
			    COUNTROWS ( FILTER ( Questoes, [@Erro] > 0.4 && [@Respostas] >= 5 ) )
		formatString: #,0
		lineageTag: ec1991c9-61c7-4c0f-9b59-4c4bf77b9bdc

	measure 'Quadros publicados' = COUNTROWS ( fato_ranking_matinal )
		formatString: #,0
