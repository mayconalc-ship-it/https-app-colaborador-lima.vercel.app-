/// Guarda-chuva das medidas. A coluna e so o suporte da tabela.
table _Medidas
	lineageTag: 0b845ede-137d-4a59-9bca-96e68c0419c3

	measure Colaboradores = DISTINCTCOUNT ( dim_colaborador[colaborador_id] )
		formatString: #,0
		lineageTag: b970fc87-e828-49e5-85b5-cbb96e520616

	measure 'Colaboradores ativos' = DISTINCTCOUNT ( fato_atividade[colaborador_id] )
		formatString: #,0
		lineageTag: 532e37c7-bdf6-4d8e-a772-9591bbbd2986

	measure '% Adesão' = DIVIDE ( [Colaboradores ativos], [Colaboradores] )
		formatString: 0.0%
		lineageTag: 85b85187-1cb0-488b-bf10-06f8e3094f22

	measure Interações = SUM ( fato_atividade[interacoes] )
		formatString: #,0
		lineageTag: 66536292-0aa9-4837-94a6-698d24b9aff0

	measure 'Módulos usados' = DISTINCTCOUNT ( fato_atividade[modulo] )
		formatString: #,0
		lineageTag: b1aff976-c1c5-4382-981e-403f68f29f96

	measure '% Adesão mês anterior' = CALCULATE ( [% Adesão], DATEADD ( dim_calendario[data], -1, MONTH ) )
		formatString: 0.0%
		lineageTag: a1c4321c-03b0-45ff-8046-9df37a086d26

	measure 'Δ Adesão' =
			VAR Atual = [% Adesão]
			VAR Anterior = [% Adesão mês anterior]
			RETURN IF ( NOT ISBLANK ( Anterior ), Atual - Anterior )
		formatString: #,0
		lineageTag: fcb2bde3-f5bd-45b1-8f1f-e9457b7d2e4f

	measure 'Colaboradores sem atividade' = [Colaboradores] - [Colaboradores ativos]
		formatString: #,0
		lineageTag: 6a8abd80-f9af-4702-b722-d0298c22eeff

	measure 'Interações — média semanal' =
			VAR Semanas =
			    ADDCOLUMNS (
			        ALLSELECTED ( dim_calendario[inicio_semana] ),
			        "@Qtd", CALCULATE ( [Interações] )
			    )
			RETURN
			    AVERAGEX ( FILTER ( Semanas, [@Qtd] > 0 ), [@Qtd] )
		formatString: 0.0
		lineageTag: 735af022-5c1a-4bbd-bc00-1f78fa57ea07

	measure 'Interações — última semana válida' =
			VAR InicioSemanaAtual = TODAY () - WEEKDAY ( TODAY (), 3 )
			VAR Semanas =
			    FILTER (
			        ADDCOLUMNS (
			            FILTER (
			                ALLSELECTED ( dim_calendario[inicio_semana] ),
			                dim_calendario[inicio_semana] < InicioSemanaAtual
			            ),
			            "@Qtd", CALCULATE ( [Interações] )
			        ),
			        [@Qtd] > 0
			    )
			VAR Ultima = MAXX ( Semanas, dim_calendario[inicio_semana] )
			RETURN
			    MAXX ( FILTER ( Semanas, dim_calendario[inicio_semana] = Ultima ), [@Qtd] )
		formatString: #,0
		lineageTag: 768e67b2-37de-434e-9217-e07d5c0ddff6

	measure 'Δ Última semana vs. média' =
			DIVIDE (
			    [Interações — última semana válida] - [Interações — média semanal],
			    [Interações — média semanal]
			)
		formatString: 0.0
		lineageTag: 2a3c9355-dc28-4b2c-bb94-d644963a20d3

	measure Contagens = COUNTROWS ( fato_ag_contagem )
		formatString: #,0
		lineageTag: 59fd3038-e5fd-4f2a-b71e-4bfea69816ff

	measure Contadores = DISTINCTCOUNT ( fato_ag_contagem[colaborador_id] )
		formatString: #,0
		lineageTag: c3217b61-b832-494a-afbc-f6bd145ec0a4

	measure 'Dias com contagem' = DISTINCTCOUNT ( fato_ag_contagem[data] )
		formatString: #,0
		lineageTag: cb75aa17-f51c-4b72-a690-ddc3426ece6d

	measure 'Total em caixas' = SUM ( fato_ag_contagem[total_caixas] )
		formatString: #,0
		lineageTag: d5bf76c4-fa1d-4054-90c6-3b648c6a69b3

	measure '% Participação AG' = DIVIDE ( [Contadores], [Colaboradores] )
		formatString: 0.0%
		lineageTag: 71d78553-e5a8-4258-a45f-5c22b3b7cfb2

	measure '% Lançado no dia' =
			DIVIDE (
			    CALCULATE ( [Contagens], fato_ag_contagem[lancado_no_dia] = TRUE () ),
			    [Contagens]
			)
		formatString: 0.0%
		lineageTag: c9bec3f2-40b6-4ef5-aec4-3d174701cbc7

	measure 'Atraso médio (dias)' = AVERAGE ( fato_ag_contagem[atraso_dias] )
		formatString: 0.0
		lineageTag: 36db1920-7325-42d7-9537-0ef24b84a718

	measure 'Linhas sem fator' = CALCULATE ( [Contagens], fato_ag_contagem[fator_ausente] = TRUE () )
		formatString: #,0
		lineageTag: c702d191-5d47-4b29-bc8b-6495e1e5a9d0

	measure 'Divergência absoluta' =
			CALCULATE (
			    SUM ( fato_ag_conciliacao[diferenca_abs] ),
			    fato_ag_conciliacao[parque_confiavel] = TRUE ()
			)
		formatString: #,0
		lineageTag: c688e83d-cece-4240-affe-c3e5b3c58300

	measure 'Itens conciliados' =
			CALCULATE (
			    COUNTROWS ( fato_ag_conciliacao ),
			    fato_ag_conciliacao[parque_confiavel] = TRUE ()
			)
		formatString: #,0
		lineageTag: 311b5e0f-2ef5-405c-bf82-9a89202df897

	measure '% Itens que bateram' =
			DIVIDE (
			    CALCULATE (
			        COUNTROWS ( fato_ag_conciliacao ),
			        fato_ag_conciliacao[parque_confiavel] = TRUE (),
			        fato_ag_conciliacao[resultado] = "Bateu"
			    ),
			    [Itens conciliados]
			)
		formatString: 0.0%
		lineageTag: 1fd635ed-4d64-4357-bafe-e003e055c20e

	measure 'Maior divergência' =
			CALCULATE (
			    MAX ( fato_ag_conciliacao[diferenca_abs] ),
			    fato_ag_conciliacao[parque_confiavel] = TRUE ()
			)
		formatString: #,0
		lineageTag: ba985b4f-da7f-47d6-bdca-8d66abff39c3

	measure 'Caixas de garrafeira' =
			CALCULATE (
			    [Total em caixas],
			    fato_ag_contagem[tipo] = "GFE sem Garrafa"
			)
		formatString: #,0
		lineageTag: 9cffdfdc-d799-4ae1-a171-28b0a2787082

	measure 'Paletes de garrafeira' =
			SUMX (
			    VALUES ( fato_ag_contagem[formato] ),
			    DIVIDE (
			        CALCULATE ( [Caixas de garrafeira] ),
			        CALCULATE ( MAX ( fato_ag_contagem[fator_palete] ) )
			    )
			)
		formatString: #,0
		lineageTag: f7983d7e-48cf-4598-bcfc-5ac0810855ac

	measure 'Ocorrências de contagem' = COUNTROWS ( fato_ag_contagem )
		formatString: #,0
		lineageTag: 960faa40-6b10-4f3b-9dbb-b2ddae40c42a

	measure 'Dias úteis no período' =
			CALCULATE (
			    COUNTROWS ( dim_calendario ),
			    dim_calendario[fim_de_semana] = FALSE (),
			    dim_calendario[ja_aconteceu] = TRUE ()
			)
		formatString: #,0
		lineageTag: 85faf06f-4bd2-4151-a360-30fd1a94858e

	measure '% Dias com contagem' = DIVIDE ( [Dias com contagem], [Dias úteis no período] )
		formatString: 0.0%
		lineageTag: 157da353-5267-449c-b541-756985baf995

	measure 'Recontagens pendentes' =
			CALCULATE (
			    COUNTROWS ( fato_ag_recontagem ),
			    fato_ag_recontagem[situacao] = "Pendente"
			)
		formatString: #,0
		lineageTag: 9d54635c-98d8-48cd-968c-7997b32176b0

	measure 'Horas médias p/ atender' = AVERAGE ( fato_ag_recontagem[horas_para_atender] )
		formatString: 0.0
		lineageTag: ecfffb04-95b7-499f-a2f9-0238cffe8cf2

	measure Feedbacks = COUNTROWS ( fato_feedback_rota )
		formatString: #,0
		lineageTag: 908faaec-4cd1-468d-a494-7b30cace9897

	measure 'Nota média' = AVERAGE ( fato_feedback_rota[nota] )
		formatString: 0.0
		lineageTag: 62267487-ec62-4d05-84c2-945884968c54

	measure '% Satisfação' = AVERAGE ( fato_feedback_rota[nota_percentual] )
		formatString: 0.0%
		lineageTag: 8102d379-a4be-4a6f-8b6b-ca39057db747

	measure '% Notas ruins' =
			DIVIDE (
			    CALCULATE ( [Feedbacks], fato_feedback_rota[nota_ruim] = TRUE () ),
			    [Feedbacks]
			)
		formatString: 0.0%
		lineageTag: 6f82fc71-6e8e-43cb-b624-efe3b1224d53

	measure 'Motoristas que responderam' = DISTINCTCOUNT ( fato_feedback_rota[colaborador_id] )
		formatString: #,0
		lineageTag: 0fcbcfdb-926a-4c5b-bd7f-27e51dfe8460

	measure 'Rotas avaliadas' = DISTINCTCOUNT ( fato_feedback_rota[rota] )
		formatString: #,0
		lineageTag: 2cfcfd1a-9120-4a4d-9c4a-0d3fdedf9b07

	measure '% Com comentário' =
			DIVIDE (
			    CALCULATE ( [Feedbacks], fato_feedback_rota[tem_comentario] = TRUE () ),
			    [Feedbacks]
			)
		formatString: 0.0%
		lineageTag: 6f58e9d7-a738-4cb1-8c48-ede1bbb3e747

	measure 'Feedbacks com ocorrência' = DISTINCTCOUNT ( fato_feedback_ocorrencia[feedback_id] )
		formatString: #,0
		lineageTag: 1040b31d-e00d-4325-b534-cb87c59b4945

	measure 'Ocorrências relatadas' = COUNTROWS ( fato_feedback_ocorrencia )
		formatString: #,0
		lineageTag: 96507e2b-cfa8-43a7-972e-8cfdf6ded2fe

	measure '% Rotas com ocorrência' = DIVIDE ( [Feedbacks com ocorrência], [Feedbacks] )
		formatString: 0.0%
		lineageTag: 9f5ed942-0e30-494f-b4fb-cd7f95774053

	measure 'Rota mais crítica' =
			VAR Rotas =
			    ADDCOLUMNS (
			        VALUES ( fato_feedback_rota[rota] ),
			        "@Nota", CALCULATE ( AVERAGE ( fato_feedback_rota[nota] ) ),
			        "@Qtd", CALCULATE ( COUNTROWS ( fato_feedback_rota ) )
			    )
			VAR Elegiveis = FILTER ( Rotas, [@Qtd] >= 3 )
			RETURN
			    MAXX ( TOPN ( 1, Elegiveis, [@Nota], ASC ), fato_feedback_rota[rota] )
		lineageTag: d317a9a0-693d-4692-96af-ad6f645e5807

	measure Análises = COUNTROWS ( fato_cinco_porques )
		formatString: #,0
		lineageTag: 40b20402-1cd1-4021-8732-22a3576c15e1

	measure 'Análises concluídas' = CALCULATE ( [Análises], fato_cinco_porques[concluida] = TRUE () )
		formatString: #,0
		lineageTag: ab7f907e-0ee0-4cc2-aa3b-6b774fd63fb0

	measure '% Conclusão' = DIVIDE ( [Análises concluídas], [Análises] )
		formatString: 0.0%
		lineageTag: cd6f920b-36df-492d-8b3f-c5479aafe90e

	measure '% Chegou ao 5º porquê' =
			DIVIDE (
			    CALCULATE ( [Análises], fato_cinco_porques[chegou_ao_quinto] = TRUE () ),
			    [Análises concluídas]
			)
		formatString: 0.0%
		lineageTag: a0141168-74d9-489b-b1bf-5e330d658e8e

	measure 'Profundidade média' = AVERAGE ( fato_cinco_porques[profundidade] )
		formatString: 0.0
		lineageTag: 685763ec-e912-4467-a2c4-ed3bd08964e9

	measure 'Aguardando tratativa' =
			CALCULATE (
			    [Análises],
			    fato_cinco_porques[concluida] = TRUE (),
			    fato_cinco_porques[tratada] = FALSE ()
			)
		formatString: #,0
		lineageTag: 1ff090ef-8aa7-4da9-ad8c-0625aa3168f6

	measure 'Horas médias até resposta' = AVERAGE ( fato_cinco_porques[horas_ate_resposta] )
		formatString: 0.0
		lineageTag: 2647e78a-cb40-4c97-96ff-917e7f03369d

	measure '% Aceite do motorista' =
			DIVIDE (
			    CALCULATE ( [Análises], fato_cinco_porques[motorista_aceitou] = TRUE () ),
			    CALCULATE ( [Análises], fato_cinco_porques[respondida_lideranca] = TRUE () )
			)
		formatString: 0.0%
		lineageTag: b285df0a-b3c4-4c08-a10c-e7da8425cd0d

	measure 'Causa raiz mais frequente' =
			VAR Causas =
			    ADDCOLUMNS (
			        VALUES ( fato_cinco_porques[categoria] ),
			        "@Qtd", CALCULATE ( COUNTROWS ( fato_cinco_porques ) )
			    )
			RETURN
			    MAXX ( TOPN ( 1, Causas, [@Qtd], DESC ), fato_cinco_porques[categoria] )
		lineageTag: 3ce9fc38-096a-420c-820a-480551a92931

	measure 'Comunicados publicados' = COUNTROWS ( fato_comunicado )
		formatString: #,0
		lineageTag: 466d7f2a-b06d-4cb8-a31a-72b6f90f7883

	measure Curtidas = SUM ( fato_comunicado[curtidas] )
		formatString: #,0
		lineageTag: cee7db35-59ea-4bdb-9730-6abbce290165

	measure 'Curtidas por comunicado' = DIVIDE ( [Curtidas], [Comunicados publicados] )
		formatString: #,0
		lineageTag: 292258d4-4929-4b6e-a6c7-ea622ae6de4a

	measure 'Taxa média de curtida' = AVERAGE ( fato_comunicado[taxa_curtida] )
		formatString: 0.0%
		lineageTag: c0a18d96-4a02-4f1c-b96f-ebf4cc988a05

	measure 'Colaboradores que interagiram' = DISTINCTCOUNT ( fato_comunicado_curtida[colaborador_id] )
		formatString: #,0
		lineageTag: 0000950a-575c-46ce-b688-dc0354c7ed29

	measure '% Participação na comunicação' = DIVIDE ( [Colaboradores que interagiram], [Colaboradores] )
		formatString: 0.0%
		lineageTag: a16033fa-e01e-4aec-a4ca-5f2a8bd54119

	measure 'Cliques no aviso (piso)' = SUM ( fato_comunicado[avisos_clicados] )
		formatString: #,0
		lineageTag: edfdeb17-b03f-47af-9624-25a5f34196d1

	measure 'Dias até curtir (mediana)' = MEDIANX ( fato_comunicado_curtida, fato_comunicado_curtida[dias_ate_curtir] )
		formatString: #,0
		lineageTag: 819027d5-aafa-4db7-a09e-5dae0a9a441b

	measure Participações = COUNTROWS ( fato_quiz_participacao )
		formatString: #,0
		lineageTag: 52dbf152-078d-4507-b735-111bff7cb11a

	measure 'Participações concluídas' = CALCULATE ( [Participações], fato_quiz_participacao[concluida] = TRUE () )
		formatString: #,0
		lineageTag: 0946654e-677c-4430-bfdd-efd528e76434

	measure 'Participantes únicos' = DISTINCTCOUNT ( fato_quiz_participacao[colaborador_id] )
		formatString: #,0
		lineageTag: 5f588eec-6c5d-4a92-b86e-65db4395ba85

	measure Rodadas = DISTINCTCOUNT ( fato_quiz_participacao[rodada_id] )
		formatString: #,0
		lineageTag: 82963781-8034-45bb-b30e-d25073f9f095

	measure 'Taxa de participação' =
			DIVIDE (
			    SUM ( fato_quiz_rodada_participacao[concluidas] ),
			    SUM ( fato_quiz_rodada_participacao[elegiveis] )
			)
		formatString: 0.0%
		lineageTag: 36450b47-8660-4048-a8d3-cce3b2734b7e

	measure 'Aproveitamento médio' = AVERAGE ( fato_quiz_participacao[aproveitamento] )
		formatString: 0.0%
		lineageTag: 1c2615a9-50ef-45ab-ad00-6ee301913d33

	measure Pontos = SUM ( fato_quiz_participacao[pontos] )
		formatString: #,0
		lineageTag: 6b413f1f-f123-4755-9f3c-84a02f0c541f

	measure Acertos = SUM ( fato_quiz_participacao[acertos] )
		formatString: #,0
		lineageTag: b5b99b10-b1d7-4085-bcf5-733fe280ee64

	measure Erros = SUM ( fato_quiz_participacao[erros] )
		formatString: #,0
		lineageTag: fe378b50-47df-416d-b2b0-d601cb484544

	measure 'Tempo médio por pergunta (s)' = AVERAGE ( fato_quiz_participacao[segundos_por_pergunta] )
		formatString: 0.0
		lineageTag: 93fb8b80-0f3f-4307-8b79-144a50814005

	measure 'Posição na temporada' =
			IF (
			    NOT ISBLANK ( [Pontos] ),
			    RANKX (
			        ALLSELECTED ( fato_quiz_participacao[colaborador] ),
			        [Pontos],
			        ,
			        DESC,
			        DENSE
			    )
			)
		formatString: #,0
		lineageTag: 514b1969-e6ee-43a8-9cf1-6c176f17220b

	measure Medalha =
			SWITCH (
			    [Posição na temporada],
			    1, "🥇",
			    2, "🥈",
			    3, "🥉",
			    ""
			)
		formatString: #,0
		lineageTag: 3a46c596-fbce-42d2-b9ec-2d4dcbfedf84

	measure 'Taxa de erro (período)' =
			DIVIDE (
			    CALCULATE (
			        COUNTROWS ( fato_quiz_resposta ),
			        fato_quiz_resposta[errou] = TRUE ()
			    ),
			    COUNTROWS ( fato_quiz_resposta )
			)
		formatString: 0.0%
		lineageTag: f24d1994-59e2-4b82-9012-af8ad90c0b71

	measure 'Questões críticas' =
			VAR Questoes =
			    ADDCOLUMNS (
			        VALUES ( fato_quiz_resposta[questao_id] ),
			        "@Erro", [Taxa de erro (período)],
			        "@Respostas", CALCULATE ( COUNTROWS ( fato_quiz_resposta ) )
			    )
			RETURN
			    COUNTROWS ( FILTER ( Questoes, [@Erro] > 0.4 && [@Respostas] >= 5 ) )
		formatString: #,0
		lineageTag: ec1991c9-61c7-4c0f-9b59-4c4bf77b9bdc

	measure 'Quadros publicados' = COUNTROWS ( fato_ranking_matinal )
		formatString: #,0
		lineageTag: fe6fc36f-e1d3-4c76-9fc8-42b4494ea628

	measure 'Meses com publicação' = DISTINCTCOUNT ( fato_ranking_matinal[mes_ano] )
		formatString: #,0
		lineageTag: 27638df8-90fc-4c21-8dc1-a3256d398e6d

	measure '% Cobertura da publicação' =
			DIVIDE (
			    CALCULATE (
			        COUNTROWS ( fato_ranking_matinal_cobertura ),
			        fato_ranking_matinal_cobertura[publicado] = TRUE ()
			    ),
			    COUNTROWS ( fato_ranking_matinal_cobertura )
			)
		formatString: 0.0%
		lineageTag: b87635e7-340b-4f63-a01f-0dd31ec10f8b

	column Coluna1
		dataType: string
		isHidden
		lineageTag: b4fc4c1b-48a0-4448-87dd-6bc3548916f4
		summarizeBy: none
		sourceColumn: Coluna1

		annotation SummarizationSetBy = Automatic

	partition _Medidas = m
		mode: import
		source =
				let
				    Tabela = #table({"Coluna1"}, {{""}})
				in
				    Tabela

	annotation PBI_ResultType = Table

