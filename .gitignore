# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# dados sensíveis de colaboradores (CPF etc.) - nunca versionar
colaboradores-raw.csv
*.env.server

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# Power BI Desktop - estado da máquina, não do relatório.
# O cache é ~1 MB de binário reescrito a cada abertura do Desktop, e o
# localSettings guarda o blob de credencial da conexão (criptografado
# pelo Windows, e por isso inútil em qualquer outra máquina). O modelo,
# as medidas e as páginas do .pbip continuam versionados normalmente --
# o editorSettings.json também, que é config do relatório e não do PC.
#
# O "**/" nao e enfeite: padrao com barra no meio fica ancorado na raiz
# do repositorio, e estas pastas estao fundo em bi/pbip/.
*.abf
**/.pbi/localSettings.json

# exportações e mídia avulsa - não fazem parte do código
*.xlsx
*.pptx
servidor.log
servidor-erro.log
srv.log
srv-err.log
